---
export interface ServiceCard { title: string; description: string; label?: string; detail?: string; duration?: string; }
interface Props { items: ServiceCard[]; variant?: 'toolkit' | 'steps'; }
const { items, variant = 'steps' } = Astro.props;
---
<div class:list={["service-card-grid", `service-card-grid--${variant}`]}>
  {items.map((item, index) => <article class="service-card" data-reveal style={`transition-delay:${index * 90}ms`}>
    <div class="service-card__top"><span class="service-card__number">{String(index + 1).padStart(2, '0')}</span>
      {variant === 'steps' && <div class="service-card__timeline"><span>{item.duration}</span><span class="service-card__flow" aria-hidden="true"><i></i><b></b></span></div>}
    </div>
    <h3>{item.title}</h3>
    <p class="service-card__description">{item.description}</p>
    {item.detail && <div class="service-card__detail"><span>{item.label}</span><p>{item.detail}</p></div>}
  </article>)}
</div>
<style is:global>
.service-card-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.service-card{position:relative;background:#F4F5F7;min-width:0;min-height:390px;padding:24px 20px 22px;display:flex;flex-direction:column;box-sizing:border-box;border-top:2px solid #0F0F0F;transition:background-color .25s,border-color .25s}.service-card:hover{border-color:#FA001E;background:#fff}.service-card__top{display:flex;align-items:flex-end;gap:12px}.service-card__number{font:700 clamp(42px,4vw,66px)/.82 Steelfish,sans-serif;color:#0F0F0F}.service-card h3{margin:34px 0 14px;font:700 clamp(22px,2vw,30px)/.95 Steelfish,sans-serif;text-transform:uppercase;text-wrap:balance}.service-card__description{margin:0;font-size:14px;line-height:1.5;color:rgba(15,15,15,.72)}.service-card__detail{margin-top:auto;padding-top:18px;border-top:1px solid rgba(15,15,15,.18)}.service-card__detail>span{font:500 9px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.09em;color:#BD0000}.service-card__detail p{font-size:12px;line-height:1.4;margin:8px 0 0}.service-card-grid--steps .service-card{min-height:480px;padding:32px 22px 40px}.service-card-grid--steps .service-card__number{font-size:clamp(52px,5vw,72px)}.service-card__timeline{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px;padding-bottom:6px;font:500 clamp(11px,1vw,13px)/1.25 Onest,sans-serif;color:rgba(15,15,15,.7);white-space:nowrap}.service-card__flow{position:relative;height:2px;background:#9A9CA1}.service-card__flow i{position:absolute;right:1px;top:-3px;width:8px;height:8px;box-sizing:border-box;border-top:2px solid #9A9CA1;border-right:2px solid #9A9CA1;transform:rotate(45deg)}.service-card-grid--steps .service-card h3{margin:44px 0 20px}.service-card-grid--steps .service-card__description{margin:0}.service-card-grid--steps .service-card__detail{padding-top:32px;display:flex;flex-direction:column;gap:6px}.service-card-grid--steps .service-card__detail>span{font:500 13px/1.3 Onest,sans-serif;text-transform:none;letter-spacing:0}.service-card-grid--steps .service-card__detail p{font:500 clamp(14px,1.2vw,17px)/1.3 Onest,sans-serif}.service-card-grid--steps .service-card:last-child{background:#FA001E;color:#E9EBEF;border-color:#FA001E}.service-card-grid--steps .service-card:last-child .service-card__number{color:#E9EBEF}.service-card-grid--steps .service-card:last-child .service-card__timeline{color:#E9EBEF}.service-card-grid--steps .service-card:last-child .service-card__flow{background:rgba(233,235,239,.65)}.service-card-grid--steps .service-card:last-child .service-card__flow i{border-color:#E9EBEF}.service-card-grid--steps .service-card:last-child .service-card__description{color:rgba(233,235,239,.85)}.service-card-grid--steps .service-card:last-child .service-card__detail{border-color:rgba(233,235,239,.35)}.service-card-grid--steps .service-card:last-child .service-card__detail>span{color:#E9EBEF}.service-card-grid--steps .service-card:last-child .service-card__detail p{color:#E9EBEF}
@media(max-width:1050px){.service-card-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.service-card{min-height:340px}.service-card-grid--toolkit .service-card:nth-child(n){min-height:320px}}
@media(max-width:650px){.service-card-grid,.service-card-grid--toolkit{grid-template-columns:1fr 1fr;gap:8px}.service-card{min-height:340px;padding:18px 15px}.service-card h3{font-size:25px;margin-top:24px}.service-card__description{font-size:13px}.service-card__detail p{font-size:11px}.service-card-grid--toolkit .service-card:nth-child(4),.service-card-grid--toolkit .service-card:nth-child(5){min-height:340px}}
@media(max-width:430px){.service-card-grid,.service-card-grid--toolkit{grid-template-columns:1fr}.service-card,.service-card-grid--toolkit .service-card:nth-child(n){min-height:300px}.service-card-grid--steps .service-card{min-height:260px}.service-card h3{font-size:28px}.service-card__description{max-width:360px}}
.service-card{background:var(--color-card);color:var(--color-ink)}.service-card__description,.service-card__detail p{font:var(--body-copy)}.service-card__number{font-family:var(--font-display);font-stretch:var(--display-stretch)}.service-card__detail>span{color:var(--color-red)}
</style>
