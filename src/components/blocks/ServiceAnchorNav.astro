---
import type { ServiceNavItem } from './ServiceHero.astro';
interface Props { items: readonly ServiceNavItem[]; }
const { items } = Astro.props;
---
<nav class="service-anchor-nav" data-service-anchor-nav aria-label="Навигация по странице">
  <i class="service-anchor-nav__fill" aria-hidden="true"></i>
  <div class="service-anchor-nav__glass" aria-hidden="true"></div>
  <div class="service-anchor-nav__items">
    {items.map((item) => <a href={item.href} data-anchor-link><span>{item.label}</span></a>)}
  </div>
</nav>
<style is:global>
/* Layered bottom-up: dark ink tint on the nav itself (same rgba(15,15,15,.92)
   as the scrolled header) → solid red fill on top of the tint → frosted glass
   (blur + saturate only, no background) over both. The dark tint cannot wash
   the red out, the glass keeps its blur level and still diffuses the fill's
   leading edge. One page-wide fill element, so the bar never splits into
   per-item sections. */
.service-anchor-nav{position:sticky;top:91px;z-index:20;width:100%;color:#E9EBEF;background:rgba(15,15,15,.74);transition:background .4s}
.service-anchor-nav__fill{position:absolute;z-index:0;top:0;bottom:0;left:var(--gutter,0px);width:0;background:var(--color-red,#FA001E);pointer-events:none;transition:width .18s linear}
.service-anchor-nav__glass{position:absolute;z-index:1;inset:0;backdrop-filter:blur(18px) saturate(1.3);border-top:1px solid rgba(233,235,239,.14);pointer-events:none}
/* Separate rule: bundlers dedupe the -webkit- alias into the standard
   property and ship only the prefixed one. */
.service-anchor-nav .service-anchor-nav__glass{-webkit-backdrop-filter:blur(18px) saturate(1.3)}
.service-anchor-nav__items{position:relative;z-index:2;display:grid;grid-template-columns:repeat(var(--anchor-count,6),minmax(0,1fr));width:100%}
.service-anchor-nav a{position:relative;min-width:0;display:flex;justify-content:center;align-items:center;min-height:41px;padding:0 10px;color:rgba(233,235,239,.72);font:600 10px/1.2 var(--font-mono,'JetBrains Mono',monospace);letter-spacing:.09em;text-transform:uppercase;white-space:nowrap;transition:color .2s}
.service-anchor-nav a:hover{color:var(--color-red,#FA001E)}
.service-anchor-nav a[aria-current="location"]{color:#E9EBEF}
.service-anchor-nav a[data-filled="true"]{color:var(--color-paper,#E9EBEF)}
.service-anchor-nav a[data-filled="true"]:hover{color:rgba(233,235,239,.7)}
.service-anchor-nav a:focus-visible{outline:1px solid var(--color-red,#FA001E);outline-offset:-3px}
html{scroll-padding-top:139px}
@media(max-width:768px){.service-anchor-nav{top:64px}.service-anchor-nav a{min-height:38px;padding:0 3px;font-size:8px;letter-spacing:.025em}html{scroll-padding-top:112px}}
@media(max-width:420px){.service-anchor-nav a{font-size:7px;letter-spacing:0}}
</style>
<script>
  const nav = document.querySelector<HTMLElement>('[data-service-anchor-nav]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-anchor-link]')];
    const targets = links.map((link) => document.querySelector<HTMLElement>(link.hash)).filter((target): target is HTMLElement => target !== null);
    const itemsCol = nav.querySelector<HTMLElement>('.service-anchor-nav__items');
    const fillEl = nav.querySelector<HTMLElement>('.service-anchor-nav__fill');
    const header = document.querySelector<HTMLElement>('[data-hdr]');
    const syncStickyTop = () => {
      const headerHeight = header?.getBoundingClientRect().height;
      if (headerHeight) nav.style.top = `${headerHeight}px`;
    };
    const isStuck = () => {
      const stickyTop = Number.parseFloat(getComputedStyle(nav).top) || 0;
      return scrollY > 40 && nav.getBoundingClientRect().top <= stickyTop + 1;
    };
    syncStickyTop();
    window.addEventListener('resize', syncStickyTop, { passive: true });
    nav.style.setProperty('--anchor-count', String(links.length));
    let frame = 0;
    const update = () => {
      frame = 0;
      nav.dataset.scrolled = isStuck() ? 'true' : 'false';
      // Activation line: a section becomes current once its top passes just
      // under the sticky header + nav bars.
      const line = 153;
      const act = targets.map((target) => target.getBoundingClientRect().top + scrollY - line);
      const n = targets.length || 1;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      let current = 0;
      act.forEach((top, index) => { if (scrollY >= top) current = index; });
      // Section-anchored progress: reaching a section's activation line puts
      // the fill at that item's centre; scrolling through the section advances
      // the fill toward the next item, so the bar always agrees with the
      // highlight. Past the last section it runs out to 100% at the end.
      let progress;
      if (current === 0 && scrollY < act[0]) {
        progress = act[0] > 0 ? (scrollY / act[0]) * (.5 / n) : .5 / n;
      } else if (current >= n - 1) {
        const from = (n - .5) / n, span = Math.max(1, maxScroll - act[current]);
        progress = Math.min(1, from + (scrollY - act[current]) / span * (1 - from));
      } else {
        const span = Math.max(1, act[current + 1] - act[current]);
        progress = Math.min(1, (current + .5) / n + (scrollY - act[current]) / span / n);
      }
      nav.style.setProperty('--progress', progress.toFixed(4));
      // Width in plain pixels: nested var()/min() math in a CSS width does
      // not parse everywhere, which left the fill detached from the edge.
      if (itemsCol && fillEl) fillEl.style.width = `${(progress * itemsCol.offsetWidth).toFixed(1)}px`;
      // Items whose centre the fill has passed flip to light text.
      const items = nav.querySelector<HTMLElement>('.service-anchor-nav__items');
      const navLeft = nav.getBoundingClientRect().left;
      const fillX = (items.getBoundingClientRect().left - navLeft) + progress * items.offsetWidth;
      links.forEach((link) => {
        const rect = link.getBoundingClientRect();
        link.dataset.filled = rect.left + rect.width / 2 - navLeft <= fillX ? 'true' : 'false';
      });
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    // rAF normally drives the update; the timeout is a safety net for webviews
    // where animation frames stay paused while the page is still scrollable.
    let fallback = 0;
    const runUpdate = () => { if (frame) cancelAnimationFrame(frame); if (fallback) clearTimeout(fallback); frame = 0; fallback = 0; update(); };
    const scheduleUpdate = () => {
      if (frame || fallback) return;
      frame = requestAnimationFrame(runUpdate);
      fallback = window.setTimeout(runUpdate, 120);
    };
    addEventListener('scroll', scheduleUpdate, { passive: true });
    addEventListener('resize', scheduleUpdate, { passive: true });
    update();
    links.forEach((link) => link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', link.hash);
    }));
  }
</script>
