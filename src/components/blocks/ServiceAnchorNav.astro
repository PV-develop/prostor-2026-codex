---
import type { ServiceNavItem } from './ServiceHero.astro';
interface Props { items: readonly ServiceNavItem[]; }
const { items } = Astro.props;
---
<nav class="service-anchor-nav" data-service-anchor-nav aria-label="Навигация по странице">
  <div class="service-anchor-nav__items">
    {items.map((item) => <a href={item.href} data-anchor-link><canvas class="service-anchor-nav__particle-tail" aria-hidden="true"></canvas><span>{item.label}</span></a>)}
  </div>
</nav>
<style is:global>
.service-anchor-nav{position:sticky;top:91px;z-index:20;width:100%;background:rgba(15,15,15,1);color:var(--color-paper,#E9EBEF);border-top:1px solid rgba(233,235,239,.14);border-bottom:1px solid rgba(233,235,239,.14);transition:background .4s,backdrop-filter .4s,-webkit-backdrop-filter .4s}
.service-anchor-nav[data-scrolled="true"]{background:rgba(15,15,15,.62);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);border-top-color:rgba(233,235,239,.34);box-shadow:0 -1px 0 rgba(233,235,239,.18)}
.service-anchor-nav__items{display:grid;grid-template-columns:repeat(var(--anchor-count,6),minmax(0,1fr));width:100%}
.service-anchor-nav a{position:relative;isolation:isolate;min-width:0;display:flex;justify-content:center;align-items:center;min-height:58px;padding:0 10px;border-right:1px solid rgba(233,235,239,.14);overflow:hidden;color:inherit;font:600 10px/1.2 var(--font-mono,'JetBrains Mono',monospace);letter-spacing:.09em;text-align:center;text-transform:uppercase;white-space:nowrap}
.service-anchor-nav a:first-child{border-left:1px solid rgba(233,235,239,.14)}
.service-anchor-nav a::before,.service-anchor-nav a::after{content:"";position:absolute;inset:0;pointer-events:none}
.service-anchor-nav a::before{z-index:0;background:var(--color-red,#FA001E);transform:scaleX(var(--scroll-fill,0));transform-origin:left center;transition:transform .18s linear}
.service-anchor-nav a::after{z-index:2;background:var(--color-ink,#0F0F0F);transform:scaleX(0);transform-origin:right center;transition:transform .45s cubic-bezier(.7,0,.2,1)}
.service-anchor-nav a>span{position:relative;z-index:3}
.service-anchor-nav__particle-tail{position:absolute;z-index:1;inset:0;width:100%;height:100%;pointer-events:none;opacity:var(--particle-tail-opacity,0)}
.service-anchor-nav a:not([data-scroll-active="true"]):hover::before{transform:scaleX(1);transition:transform .45s cubic-bezier(.7,0,.2,1)}
.service-anchor-nav a[data-scroll-active="true"]:hover::after{transform:scaleX(1)}
.service-anchor-nav a[aria-current="location"]{color:#fff}
.service-anchor-nav a:focus-visible{outline:1px solid var(--color-red,#FA001E);outline-offset:-3px}
html{scroll-padding-top:156px}[id]{scroll-margin-top:156px}
@media(max-width:768px){.service-anchor-nav{top:64px}.service-anchor-nav a{min-height:52px;padding:0 3px;font-size:8px;letter-spacing:.025em}html{scroll-padding-top:128px}[id]{scroll-margin-top:128px}}
@media(max-width:420px){.service-anchor-nav a{font-size:7px;letter-spacing:0}}
</style>
<script>
  const nav = document.querySelector<HTMLElement>('[data-service-anchor-nav]');
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-anchor-link]')];
    const targets = links.map((link) => document.querySelector<HTMLElement>(link.hash)).filter((target): target is HTMLElement => target !== null);
    const header = document.querySelector<HTMLElement>('[data-hdr]');
    const syncStickyTop = () => {
      const headerHeight = header?.getBoundingClientRect().height;
      if (headerHeight) nav.style.top = `${headerHeight}px`;
    };
    const isStuck = () => {
      const stickyTop = Number.parseFloat(getComputedStyle(nav).top) || 0;
      return scrollY > 40 && nav.getBoundingClientRect().top <= stickyTop + 1;
    };
    syncStickyTop();
    window.addEventListener('resize', syncStickyTop, { passive: true });
    const syncHeaderGlass = () => {
      if (!header || !isStuck()) return;
      const headerStyle = getComputedStyle(header);
      nav.style.background = header.style.background || headerStyle.backgroundColor;
      nav.style.backdropFilter = header.style.backdropFilter || headerStyle.backdropFilter;
      nav.style.setProperty('-webkit-backdrop-filter', header.style.getPropertyValue('-webkit-backdrop-filter') || nav.style.backdropFilter);
    };
    if (header) new MutationObserver(syncHeaderGlass).observe(header, { attributes: true, attributeFilter: ['style'] });
    const particleFields = new WeakMap<HTMLCanvasElement, Array<{ x: number; y: number; radius: number; alpha: number; light: boolean; phase: number }>>();
    const randomFor = (seed: number) => { let value = seed >>> 0; return () => { value = (value * 1664525 + 1013904223) >>> 0; return value / 4294967296; }; };
    const drawParticleTail = (link: HTMLAnchorElement, fill: number, index: number) => {
      const canvas = link.querySelector<HTMLCanvasElement>('.service-anchor-nav__particle-tail');
      if (!canvas) return;
      const rect = link.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1), width = rect.width, height = rect.height;
      if (canvas.width !== Math.round(width * dpr) || canvas.height !== Math.round(height * dpr)) {
        canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr);
      }
      canvas.style.opacity = fill > 0 && fill < 1 ? '1' : '0';
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, width, height);
      if (fill <= 0 || fill >= 1) return;
      let particles = particleFields.get(canvas);
      if (!particles) {
        const random = randomFor(index + 1847);
        particles = Array.from({ length: 640 }, () => ({
          x: Math.pow(random(), 1.55), y: random() * 1.45 - .22,
          radius: .45 + random() * 1.15, alpha: .22 + random() * .72,
          light: random() > .93, phase: random() * Math.PI * 2,
        }));
        particleFields.set(canvas, particles);
      }
      const edge = width * fill, tailWidth = Math.min(148, Math.max(0, width - edge)), time = performance.now() * .001;
      const chipAway = ctx.createLinearGradient(Math.max(0, edge - 18), 0, edge + 1, 0);
      chipAway.addColorStop(0, 'rgba(15,15,15,0)'); chipAway.addColorStop(1, 'rgba(15,15,15,.96)');
      ctx.fillStyle = chipAway; ctx.fillRect(Math.max(0, edge - 18), 0, Math.min(width - Math.max(0, edge - 18), 20), height);
      for (const particle of particles) {
        const x = edge - 18 + particle.x * (tailWidth + 18) + Math.sin(time + particle.phase) * .8;
        const y = particle.y * height + Math.cos(time * .8 + particle.phase) * .9;
        const fade = Math.pow(1 - particle.x, 1.15) * particle.alpha;
        ctx.globalAlpha = fade;
        ctx.fillStyle = particle.light ? '#E9EBEF' : '#FA001E';
        ctx.beginPath(); ctx.arc(x, y, particle.radius, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    };
    let particleFrame = 0, particleStopAt = 0;
    const animateParticleTails = () => {
      if (performance.now() >= particleStopAt) { particleFrame = 0; return; }
      links.forEach((link, index) => drawParticleTail(link, Number(link.style.getPropertyValue('--scroll-fill')) || 0, index));
      particleFrame = requestAnimationFrame(animateParticleTails);
    };
    nav.style.setProperty('--anchor-count', String(links.length));
    let frame = 0;
    const update = () => {
      frame = 0;
      const scrolled = isStuck();
      nav.dataset.scrolled = scrolled ? 'true' : 'false';
      if (scrolled && header) {
        syncHeaderGlass();
      } else {
        nav.style.removeProperty('background-color');
        nav.style.removeProperty('backdrop-filter');
        nav.style.removeProperty('-webkit-backdrop-filter');
      }
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const progress = Math.max(0, Math.min(1, scrollY / maxScroll)) * links.length;
      links.forEach((link, index) => {
        const fill = Math.max(0, Math.min(1, progress - index));
        link.style.setProperty('--scroll-fill', `${fill}`);
        link.style.setProperty('--particle-tail-opacity', fill > 0 && fill < 1 ? '1' : '0');
        link.dataset.scrollActive = fill > 0 ? 'true' : 'false';
        drawParticleTail(link, fill, index);
      });
      if (links.some((link) => { const fill = Number(link.style.getPropertyValue('--scroll-fill')); return fill > 0 && fill < 1; })) {
        particleStopAt = performance.now() + 900;
        if (!particleFrame) particleFrame = requestAnimationFrame(animateParticleTails);
      }
      const currentIndex = targets.reduce((active, target, index) => target.getBoundingClientRect().top <= 170 ? index : active, 0);
      links.forEach((link, index) => {
        if (index === currentIndex) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const scheduleUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
    addEventListener('scroll', scheduleUpdate, { passive: true });
    addEventListener('resize', scheduleUpdate, { passive: true });
    update();
    links.forEach((link) => link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', link.hash);
    }));
  }
</script>
