---
export interface ProcessCard {
  title: string;
  description: string;
  duration: string;
  label: string;
  detail: string;
}

interface Props { items: ProcessCard[]; inset?: boolean; carousel?: boolean; }
const { items, inset = true, carousel = false } = Astro.props;
---
<div class:list={["process-cards", !inset && "process-cards--flush", carousel && "process-cards--carousel"]} lang="ru" data-m={carousel ? "proc" : undefined}>
  {items.map((item, index) => <article class="process-card" data-reveal style={`transition-delay:${index * 90}ms`}>
    <div class="process-card__top">
      <span class="process-card__number">{String(index + 1).padStart(2, '0')}</span>
      <div class="process-card__timeline">
        <span>{item.duration}</span>
        <span class="process-card__flow" aria-hidden="true"><i></i></span>
      </div>
    </div>
    <h3>{item.title}</h3>
    <p class="process-card__description">{item.description}</p>
    <div class="process-card__detail"><span>{item.label}</span><p>{item.detail}</p></div>
  </article>)}
</div>
<style is:global>
.process-cards{padding:0 var(--gutter);display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0 12px;hyphens:auto;-webkit-hyphens:auto;overflow-wrap:break-word}.process-cards--flush{padding-left:0;padding-right:0}.process-card{position:relative;z-index:1;background:#F4F5F7;color:#0F0F0F;padding:32px clamp(18px,1.6vw,28px) 40px;display:flex;flex-direction:column;min-width:0;min-height:480px;box-sizing:border-box}.process-card:last-child{background:#FA001E;color:#E9EBEF}.process-card__top{display:flex;align-items:flex-end;gap:12px}.process-card__number{font:var(--type-step-number);letter-spacing:-.02em;flex:none}.process-card__timeline{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px;padding-bottom:6px;font:600 12px/1.2 Onest,sans-serif;text-transform:uppercase;letter-spacing:.01em;color:#0F0F0F;white-space:nowrap}.process-card__flow{position:relative;height:2px;background:#9A9CA1}.process-card__flow i{position:absolute;right:1px;top:-3px;width:8px;height:8px;box-sizing:border-box;border-top:2px solid #9A9CA1;border-right:2px solid #9A9CA1;transform:rotate(45deg)}.process-card h3{margin:44px 0 20px}.process-card__number,.process-card h3{font-stretch:var(--display-stretch)}.process-card__description{margin:0;font:var(--type-body-small);color:rgba(15,15,15,.7);text-wrap:pretty}.process-card__detail{margin-top:auto;padding-top:32px;border-top:1px solid rgba(15,15,15,.14);display:flex;flex-direction:column;gap:6px}.process-card__detail>span{font:var(--type-label);color:#BD0000;text-transform:uppercase}.process-card__detail p{font:var(--type-body);text-wrap:pretty;margin:0}.process-card:last-child .process-card__timeline,.process-card:last-child .process-card__detail>span,.process-card:last-child .process-card__detail p{color:#E9EBEF}.process-card:last-child .process-card__flow{background:rgba(233,235,239,.65)}.process-card:last-child .process-card__flow i{border-color:#E9EBEF}.process-card:last-child .process-card__description{color:rgba(233,235,239,.85)}.process-card:last-child .process-card__detail{border-color:rgba(233,235,239,.35)}
@media(max-width:1050px){.process-cards{grid-template-columns:repeat(3,minmax(0,1fr));padding:0 30px}.process-card{min-height:400px}}
@media(max-width:680px){.process-cards{grid-template-columns:1fr 1fr;gap:8px;padding:0 21px}.process-card{min-height:340px;padding:22px 16px 26px}.process-card h3{margin:30px 0 16px}.process-card__detail{padding-top:22px}}
@media(max-width:430px){.process-cards{grid-template-columns:1fr}.process-card{min-height:300px}}
.process-cards.process-cards--flush{padding-left:0;padding-right:0}
@media(max-width:768px){.process-cards--carousel{display:flex;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:0 20px;scrollbar-width:none;gap:2px;padding:0 20px 4px}.process-cards--carousel::-webkit-scrollbar{display:none}.process-cards--carousel .process-card{flex:0 0 100%;scroll-snap-align:start;min-height:0}}
@media(min-width:431px) and (max-width:768px){.process-cards--carousel{gap:12px}.process-cards--carousel .process-card{flex:0 0 40vw;min-height:400px}}
@media(min-width:769px) and (max-width:1800px){.process-cards--carousel{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:12px;overflow:visible;scroll-snap-type:none;scroll-padding:0;padding:0 30px}.process-cards--carousel .process-card{flex:none;scroll-snap-align:none;min-height:400px}}
</style>
