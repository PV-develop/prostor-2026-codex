---
export interface ProcessCard {
  title: string;
  description: string;
  duration: string;
  label: string;
  detail: string;
}

interface Props { items: ProcessCard[]; inset?: boolean; }
const { items, inset = true } = Astro.props;
---
<div class:list={["process-cards", !inset && "process-cards--flush"]} lang="ru">
  {items.map((item, index) => <article class="process-card" data-reveal style={`transition-delay:${index * 90}ms`}>
    <div class="process-card__top">
      <span class="process-card__number">{String(index + 1).padStart(2, '0')}</span>
      <div class="process-card__timeline">
        <span>{item.duration}</span>
        <span class="process-card__flow" aria-hidden="true"><i></i></span>
      </div>
    </div>
    <h3>{item.title}</h3>
    <p class="process-card__description">{item.description}</p>
    <div class="process-card__detail"><span>{item.label}</span><p>{item.detail}</p></div>
  </article>)}
</div>
<style is:global>
.process-cards{padding:0 48px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0 12px;hyphens:auto;-webkit-hyphens:auto;overflow-wrap:break-word}.process-cards--flush{padding-left:0;padding-right:0}.process-card{position:relative;z-index:1;background:#F4F5F7;color:#0F0F0F;padding:32px clamp(18px,1.6vw,28px) 40px;display:flex;flex-direction:column;min-width:0;min-height:480px;box-sizing:border-box}.process-card:last-child{background:#FA001E;color:#E9EBEF}.process-card__top{display:flex;align-items:flex-end;gap:12px}.process-card__number{font:700 clamp(52px,5vw,72px)/.8 Steelfish,sans-serif;letter-spacing:-.02em;flex:none}.process-card__timeline{flex:1;min-width:0;display:flex;flex-direction:column;gap:8px;padding-bottom:6px;font:500 clamp(11px,1vw,13px)/1.25 Onest,sans-serif;color:rgba(15,15,15,.7);white-space:nowrap}.process-card__flow{position:relative;height:2px;background:#9A9CA1}.process-card__flow i{position:absolute;right:1px;top:-3px;width:8px;height:8px;box-sizing:border-box;border-top:2px solid #9A9CA1;border-right:2px solid #9A9CA1;transform:rotate(45deg)}.process-card h3{margin:44px 0 20px;font:700 clamp(22px,1.9vw,32px)/.95 Steelfish,sans-serif;text-transform:uppercase;text-wrap:balance}.process-card__number,.process-card h3{font-stretch:25%}.process-card__description{margin:0;font-size:clamp(13px,1.1vw,15px);line-height:1.5;color:rgba(15,15,15,.7);text-wrap:pretty}.process-card__detail{margin-top:auto;padding-top:32px;border-top:1px solid rgba(15,15,15,.14);display:flex;flex-direction:column;gap:6px}.process-card__detail>span{font:500 13px/1.3 Onest,sans-serif;color:#BD0000}.process-card__detail p{font:500 clamp(14px,1.2vw,17px)/1.3 Onest,sans-serif;text-wrap:pretty;margin:0}.process-card:last-child .process-card__timeline,.process-card:last-child .process-card__detail>span,.process-card:last-child .process-card__detail p{color:#E9EBEF}.process-card:last-child .process-card__flow{background:rgba(233,235,239,.65)}.process-card:last-child .process-card__flow i{border-color:#E9EBEF}.process-card:last-child .process-card__description{color:rgba(233,235,239,.85)}.process-card:last-child .process-card__detail{border-color:rgba(233,235,239,.35)}
@media(max-width:1050px){.process-cards{grid-template-columns:repeat(3,minmax(0,1fr));padding:0 30px}.process-card{min-height:400px}}
@media(max-width:680px){.process-cards{grid-template-columns:1fr 1fr;gap:8px;padding:0 21px}.process-card{min-height:340px;padding:22px 16px 26px}.process-card h3{margin:30px 0 16px;font-size:25px}.process-card__description{font-size:13px}.process-card__detail{padding-top:22px}}
@media(max-width:430px){.process-cards{grid-template-columns:1fr}.process-card{min-height:300px}.process-card h3{font-size:28px}}
</style>
