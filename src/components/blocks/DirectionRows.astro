---
export interface Direction { title: string; href: string; description: string; tags: string; badge?: string }
interface Props { items: Direction[] }
const { items } = Astro.props;
---
{items.map((item) => (
  <a href={item.href} class="direction-row export-hover-40" data-reveal data-m="srow">
    {item.badge ? <span class="direction-row__heading"><span class="direction-row__badge">{item.badge}</span><span class="service-title service-title--row">{item.title}</span></span>
      : <span class="service-title service-title--row">{item.title}</span>}
    <span class="direction-row__description">{item.description}<br /><span>{item.tags}</span></span>
    <span class="direction-row__arrow">→</span>
  </a>
))}
<style>
  .direction-row { display:grid; align-items:center; padding:36px var(--gutter); border-bottom:1px solid #C2C5CA; background-image:linear-gradient(0deg,var(--color-ink) 50%,transparent 50%); background-size:100% 201%; background-position:0 0; background-repeat:no-repeat; transition:background-position .6s cubic-bezier(.7,0,.2,1),color .4s }
  .direction-row__heading { display:flex; flex-direction:row-reverse; justify-content:flex-end; align-items:flex-start; gap:14px }
  .direction-row__badge { font:600 12px/1 Onest,sans-serif; letter-spacing:.01em; background:var(--color-red); color:var(--color-ink); padding:5px 8px; margin-top:calc(clamp(40px,5vw,72px) * .06) }
  .direction-row__description { font:var(--type-body); opacity:.8; max-width:420px; text-wrap:pretty }
  .direction-row__description > span { font:var(--type-label); letter-spacing:0; display:block; margin-top:14px; opacity:.65 }
  .direction-row__arrow { width:56px; height:56px; border:1px solid currentColor; display:flex; align-items:center; justify-content:center; font:var(--type-icon) }
</style>
