<style is:global>
/* In-page section nav lives inside the header and only exists in its stuck
   state: the wordmark collapses to the red icon at the same 40px threshold,
   freeing the centre zone. The row runs logo mark → CTA with no insets: the
   separators are flexible lines that stretch to fill the distance, keeping
   a fixed 5px clearance to every word. Mono caps links, the current section
   in the brand red, flanked by red lines (reference: menu (3).jpg). */
[data-hdr]{border-bottom:1px solid transparent}
[data-hdr-anchor]{flex:1 1 auto;min-width:0;display:flex;visibility:hidden;transition:visibility 0s linear .25s}
/* The reveal waits out the logo collapse (letters fly out, the red mark pops
   in — about 1.3s) so the growing line never crosses the animating mark. */
[data-hdr][data-stuck="true"] [data-hdr-anchor]{visibility:visible;transition:visibility 0s linear 1.3s}
[data-hdr-roll]{width:100%;min-width:0;display:flex;align-items:center;gap:5px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
[data-hdr-roll]::-webkit-scrollbar{display:none}
[data-hdr-roll] a{flex:none;display:flex;align-items:center;padding:9px 0;color:rgba(15,15,15,.72);font:var(--type-button);letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;opacity:0;transform:translateX(-8px);transition:color .2s,opacity .2s ease,transform .2s ease}
[data-hdr-roll] .hdr-sep{flex:1 1 auto;min-width:8px;height:1px;background:linear-gradient(90deg,var(--color-red,#FA001E) var(--fill,0%),rgba(15,15,15,.25) var(--fill,0%));opacity:0;transform:scaleX(0);transform-origin:left center;transition:opacity .2s ease,transform .2s ease}
[data-hdr-roll] a:hover{color:var(--color-red,#FA001E)}
[data-hdr-roll] a[aria-current="location"]{color:var(--color-red,#FA001E)}
[data-hdr-roll] a[data-passed="1"]{color:var(--color-ink,#0F0F0F)}
/* Sequential reveal from the logo side: a dash grows out, then the next
   word slides in, pair after pair — --i staggers every element of the row.
   The whole sequence starts only after the logo collapse has finished. */
[data-hdr][data-stuck="true"] [data-hdr-roll] a{animation:hdr-word .3s cubic-bezier(.2,.7,.2,1) calc(var(--i,0)*28ms + 1.3s) both}
[data-hdr][data-stuck="true"] [data-hdr-roll] .hdr-sep{animation:hdr-dash .3s cubic-bezier(.2,.7,.2,1) calc(var(--i,0)*28ms + 1.3s) both}
@keyframes hdr-word{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none}}
@keyframes hdr-dash{from{opacity:0;transform:scaleX(0)}to{opacity:1;transform:scaleX(1)}}
@media (prefers-reduced-motion: reduce){[data-hdr-roll] a,[data-hdr-roll] .hdr-sep{animation:none!important;opacity:1!important;transform:none!important}}
/* Stuck chrome: the phone folds away and the «Меню» label collapses to a
   bare burger, so the bar reads as the compact reference header. The logo
   box shrinks to the red mark and the header grid gap drops to 0, so the
   first line starts flush at the mark; the folded phone's negative margin
   cancels its flex gap so the last line ends flush at the CTA. */
[data-hdr][data-stuck="true"]{gap:0!important;border-bottom-color:rgba(15,15,15,.28)}
[data-hdr][data-stuck="true"] [data-logo]{width:26px!important;background-position:0 0!important}
/* !important: the button's inline `all:unset` resets gap to `normal`, which
   an author rule cannot otherwise beat. */
[data-mbtn]{gap:10px!important}
[data-hdr] [data-m="hphone"]{overflow:hidden;max-width:220px;white-space:nowrap;transition:max-width .4s cubic-bezier(.2,.7,.2,1),opacity .25s ease .1s,margin-right .4s cubic-bezier(.2,.7,.2,1)}
[data-hdr][data-stuck="true"] [data-m="hphone"]{max-width:0;opacity:0;margin-right:-16px}
[data-hdr] [data-m="hright"] [data-mblabel]{overflow:hidden;max-width:60px;white-space:nowrap;transition:max-width .35s cubic-bezier(.2,.7,.2,1),opacity .2s ease}
[data-hdr][data-stuck="true"] [data-m="hright"] [data-mblabel]{max-width:0;opacity:0}
[data-hdr][data-stuck="true"] [data-mbtn]{gap:0!important}
html{scroll-padding-top:115px}
[data-menu] [data-action-click="closeMenu"]{background-image:linear-gradient(0deg,#0F0F0F 50%,transparent 50%)!important;background-size:100% 201%!important;background-position:0 0!important;background-repeat:no-repeat!important;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s,border-color .35s!important}
@media(max-width:1440px){[data-hdr-anchor]{display:none!important}}
@media(max-width:768px){[data-hdr-anchor]{display:none!important}[data-hdr-roll] a{padding:8px 0;font:var(--type-button);letter-spacing:.02em}[data-hdr-roll] .hdr-sep{min-width:6px}html{scroll-padding-top:92px}}
/* The compact SVG mark has a transparent edge inside its link box. */
[data-hdr-roll] > .hdr-sep:first-child{margin-left:-5px}
@media(max-width:768px){[data-menu] [data-action-click="closeMenu"]>span:first-child{display:none!important}}
</style>
<script>
  const header = document.querySelector<HTMLElement>('[data-hdr]');
  const syncHeaderScrollState = () => {
    if (header) header.dataset.stuck = window.scrollY > 40 ? 'true' : 'false';
  };
  syncHeaderScrollState();
  addEventListener('scroll', syncHeaderScrollState, { passive: true });

  // Tracks the current section for the header's in-page nav and paints the
  // segmented line as a scroll progress bar: the red fill runs from the logo
  // to the CTA, section-anchored exactly like the retired sticky bar was (a
  // section's activation point puts the fill at its word's centre, scrolling
  // through the section advances it toward the next). rAF drives the update;
  // the timeout is a safety net for webviews where frames stay paused while
  // the page still scrolls.
  const nav = document.querySelector<HTMLElement>('[data-hdr-anchor]');
  if (nav) {
    const roll = nav.querySelector<HTMLElement>('[data-hdr-roll]');
    // Blocks opt in with data-page-nav; its value overrides the derived label.
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-page-nav]')];
    const items = blocks
      .map((block) => {
        const labelledBy = block.getAttribute('aria-labelledby');
        const labelledHeading = labelledBy ? document.getElementById(labelledBy) : null;
        const screenLabel = block.dataset.screenLabel?.replace(/^\d+\s*/, '').trim();
        const headingLabel = labelledHeading?.textContent?.trim()
          || block.querySelector<HTMLElement>('h2, h3')?.textContent?.trim()
          || '';
        return {
          id: block.id,
          label: block.dataset.pageNav?.trim() || screenLabel || headingLabel,
        };
      })
      .filter((item) => item.id && item.label);

    if (roll) {
      const elements: HTMLElement[] = [];
      items.forEach((item, index) => {
        const separator = document.createElement('i');
        separator.className = 'hdr-sep';
        separator.setAttribute('aria-hidden', 'true');
        separator.style.setProperty('--i', String(index * 2));
        elements.push(separator);

        const link = document.createElement('a');
        link.href = `#${item.id}`;
        link.dataset.anchorLink = '';
        link.style.setProperty('--i', String(index * 2 + 1));
        link.textContent = item.label;
        elements.push(link);
      });

      if (items.length) {
        const separator = document.createElement('i');
        separator.className = 'hdr-sep';
        separator.setAttribute('aria-hidden', 'true');
        separator.style.setProperty('--i', String(items.length * 2));
        elements.push(separator);
      }

      roll.replaceChildren(...elements);
    }

    nav.toggleAttribute('hidden', items.length === 0);
  }

  if (nav?.querySelector('[data-anchor-link]')) {
    const roll = nav.querySelector<HTMLElement>('[data-hdr-roll]');
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('[data-anchor-link]')];
    const seps = roll ? [...roll.querySelectorAll<HTMLElement>('.hdr-sep')] : [];
    const targets = links.map((link) => document.querySelector<HTMLElement>(link.hash)).filter((target): target is HTMLElement => target !== null);
    const line = () => (nav.closest<HTMLElement>('[data-hdr]')?.offsetHeight ?? 91) + 24;
    let frame = 0;
    let fallback = 0;
    const update = () => {
      frame = 0; fallback = 0;
      const l = line();
      const n = targets.length || 1;
      const act = targets.map((target) => target.getBoundingClientRect().top + scrollY - l);
      let current = 0;
      act.forEach((top, index) => { if (scrollY >= top) current = index; });
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
        // Sections already scrolled through read in the heading ink; the
        // rest stay muted until the fill reaches them.
        if (index < current) link.dataset.passed = '1';
        else delete link.dataset.passed;
      });
      if (!roll || !seps.length) return;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      let progress: number;
      if (current === 0 && scrollY < act[0]) {
        progress = act[0] > 0 ? (scrollY / act[0]) * (.5 / n) : .5 / n;
      } else if (current >= n - 1) {
        const from = (n - .5) / n, span = Math.max(1, maxScroll - act[current]);
        progress = Math.min(1, from + (scrollY - act[current]) / span * (1 - from));
      } else {
        const span = Math.max(1, act[current + 1] - act[current]);
        progress = Math.min(1, (current + .5) / n + (scrollY - act[current]) / span / n);
      }
      // Map the page progress onto the row's content width, then clip each
      // line segment to how much of it the fill has reached.
      const fillPx = progress * roll.scrollWidth;
      const rollLeft = roll.getBoundingClientRect().left - roll.scrollLeft;
      seps.forEach((sep) => {
        const start = sep.getBoundingClientRect().left - rollLeft;
        const span = Math.max(1, sep.offsetWidth);
        const pct = Math.max(0, Math.min(1, (fillPx - start) / span));
        sep.style.setProperty('--fill', `${(pct * 100).toFixed(1)}%`);
      });
    };
    const run = () => { if (frame) cancelAnimationFrame(frame); if (fallback) clearTimeout(fallback); update(); };
    const schedule = () => {
      if (frame || fallback) return;
      frame = requestAnimationFrame(run);
      fallback = window.setTimeout(run, 120);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    // Throttled webviews can stall both rAF and timers; a light poll keeps
    // the bar and the current section in step with the real scroll position.
    window.setInterval(update, 400);
    schedule();
    links.forEach((link) => link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.hash);
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', link.hash);
    }));
  }
</script>

