---
import { contactDetails } from '../../data/site-contacts';
interface Props { sections?: string[]; activeSection?: 'home' | 'services'; theme?: 'light' | 'dark'; }
const { sections, activeSection = 'home', theme = 'light' } = Astro.props;
const sectionHref = (id: string) => sections && !sections.includes(id)
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/#${id}` : `#${id}`;
// Light is the current design system; the dark variant stays available for
// rollback (the retired dark Hero passes theme="dark").
const dark = theme === 'dark';
const logoSrc = dark ? '/src/logo-white.svg' : '/src/logo-black.svg';
const menuBorder = dark ? 'rgba(233,235,239,.32)' : 'rgba(15,15,15,.32)';
const menuColor = dark ? '#E9EBEF' : '#0F0F0F';
// Menu button fills bottom-up on hover, same wipe as the hero outline buttons.
const menuFill = dark ? '#E9EBEF' : '#0F0F0F';
const menuHoverClass = dark ? 'export-hover-130' : 'export-hover-129';
---
<div data-active-section={activeSection}><div aria-hidden="true" data-hsp="" style="height:91px"></div><div style="display:grid;grid-template-columns:auto minmax(0,1fr);gap:24px;align-items:center;padding:24px var(--gutter);position:fixed;top:0;left:0;right:0;margin:0 auto;box-sizing:border-box;z-index:50;background:rgba(15,15,15,0);transition:background .4s,backdrop-filter .4s,-webkit-backdrop-filter .4s,border-color .25s" data-hdr="" data-hdr-theme={theme}><a href="/" data-logo="" aria-label="Простор — на главную" style="position:relative;display:block;height:26px;width:128px"><img data-logo-word="" src={logoSrc} alt="" style="position:absolute;top:0;left:-39px;height:26px;width:auto;max-width:none;clip-path:inset(0 0 0 39px)"></a><div data-m="hmid" style="display:flex;align-items:center;min-width:0"><nav data-hdr-anchor aria-label="Навигация по странице" hidden><div data-hdr-roll></div></nav><div data-m="hright" style="display:flex;gap:16px;align-items:center;margin-left:auto;font:500 12px 'JetBrains Mono',monospace;letter-spacing:.08em;white-space:nowrap"><span data-m="hphone" style="font:var(--type-h5);font-stretch:25%;letter-spacing:.02em">{contactDetails.phone.label}</span><a href="#" style="background-image:linear-gradient(0deg,#BD0000 50%,#FA001E 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;color:#E9EBEF;padding:14px 18px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s" class="export-hover-127"><span data-mfull="">Обсудить задачу</span><span data-mshort="" style="display:none">Обсудить</span> <span>↗</span></a><button data-mbtn="" aria-label="Меню" style={`all:unset;box-sizing:border-box;display:flex;align-items:center;height:44px;padding:13px 16px;border:1px solid ${menuBorder};color:${menuColor};background-image:linear-gradient(0deg,${menuFill} 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;font:var(--type-button);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s,gap .35s cubic-bezier(.2,.7,.2,1)`} data-action-click="toggleMenu" class={menuHoverClass}><span data-mblabel="">Меню</span><span style="display:flex;flex-direction:column;gap:3px"><span style="width:14px;height:1.5px;background:currentColor"></span><span style="width:14px;height:1.5px;background:currentColor"></span><span style="width:14px;height:1.5px;background:currentColor"></span></span></button></div></div></div><div data-menu="" data-open="false" style="position:fixed;top:0;left:0;right:0;z-index:60;box-sizing:border-box;background:#E9EBEF;color:#0F0F0F;height:100svh;overflow:auto;padding:0"><div data-mh="" style="display:grid;grid-template-columns:auto minmax(0,1fr);gap:24px;align-items:center;padding:24px var(--gutter);border-bottom:1px solid rgba(15,15,15,.14)"><a href="/" aria-label="Простор — на главную" style="display:flex;height:26px;align-items:center"><img src="/src/logo-black.svg" alt="" style="display:block;height:26px;width:auto"></a><div data-m="hright" style="display:flex;gap:16px;align-items:center;justify-self:end;font:500 12px 'JetBrains Mono',monospace;letter-spacing:.08em;white-space:nowrap"><span data-m="hphone" style="font:var(--type-h5);font-stretch:25%;letter-spacing:.02em;color:#0F0F0F">{contactDetails.phone.label}</span><button aria-label="Закрыть меню" style="all:unset;box-sizing:border-box;display:flex;align-items:center;gap:10px;height:44px;padding:13px 16px;border:1px solid rgba(15,15,15,.32);color:#0F0F0F;font:var(--type-button);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .3s,color .3s" data-action-click="closeMenu" class="export-hover-3"><span>Закрыть</span><span style="display:flex"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true" style="width:14px;height:14px;display:block"><path d="M1 1l12 12M13 1L1 13"></path></svg></span></button></div></div><div data-mg="" style="display:grid;grid-template-columns:3fr 6fr 2.4fr;gap:40px;padding:26px var(--gutter) 0"><nav data-mmain="" aria-label="Разделы сайта" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start;border-right:1px solid rgba(15,15,15,.12);padding-right:36px"><a href={sectionHref('directions')} style="display:flex;align-items:flex-start;gap:14px;font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F;transition:color .25s" class="export-hover-4">Направления</a><a href={sectionHref('cases')} style="display:flex;align-items:flex-start;gap:14px;font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F;transition:color .25s" class="export-hover-5">Кейсы и отрасли</a><a href={sectionHref('process')} style="display:flex;align-items:flex-start;gap:14px;font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F;transition:color .25s" class="export-hover-6">Процесс и команда</a><a href={sectionHref('reviews')} style="display:flex;align-items:flex-start;gap:14px;font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F;transition:color .25s" class="export-hover-7">Отзывы</a><a href={sectionHref('contacts')} style="display:flex;align-items:flex-start;gap:14px;font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F;transition:color .25s" class="export-hover-8">Контакты</a><a href="#" data-mextra="" style="font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F">Цены</a><a href="#" data-mextra="" style="font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F">О компании</a><a href="#" data-mextra="" style="font:var(--type-nav-title);font-stretch:25%;text-transform:uppercase;color:#0F0F0F">Блог</a></nav><div data-mservices=""><div data-msnav="" style="display:grid;grid-template-colum