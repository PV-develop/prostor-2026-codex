---
import type { ServiceCard } from './ServiceCardGrid.astro';
interface Props { items: ServiceCard[]; featuredText?: string; }
const { items, featuredText } = Astro.props;
---
<div class="service-decision-matrix" role="table" aria-label="Как принимаем решения о распределении бюджета">
  <div class="service-decision-matrix__main">
  <div class="service-decision-matrix__head" role="row"><span role="columnheader">Что выясняем</span><span role="columnheader">Какое решение принимаем</span></div>
  {items.map((item, index) => <div class="service-decision-matrix__row" role="row">
    <div class="service-decision-matrix__question" role="cell"><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3></div>
    <div class="service-decision-matrix__answer" role="cell"><span aria-hidden="true">→</span><p>{item.description}</p></div>
  </div>)}
  </div>
  {featuredText && <aside class="service-decision-matrix__feature">{featuredText}</aside>}
</div>
<style is:global>
.service-decision-matrix{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,.25fr);gap:30px;align-items:stretch}.service-decision-matrix__main{border-top:1px solid rgba(15,15,15,.25)}.service-decision-matrix__head,.service-decision-matrix__row{display:grid;grid-template-columns:minmax(0,43fr) minmax(0,57fr)}.service-decision-matrix__head{padding:0 0 13px 42px;font:500 9px 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:rgba(15,15,15,.55)}.service-decision-matrix__head span+span{padding-left:26px}.service-decision-matrix__row{border-top:1px solid rgba(15,15,15,.15);min-height:92px;align-items:center}.service-decision-matrix__question{display:grid;grid-template-columns:30px 1fr;gap:12px;align-items:center;padding:17px 22px 17px 0}.service-decision-matrix__question>span{color:#FA001E;font:500 10px 'JetBrains Mono',monospace}.service-decision-matrix__question h3{font:700 clamp(23px,2.3vw,34px)/.96 Steelfish,sans-serif;text-transform:uppercase;margin:0}.service-decision-matrix__answer{display:grid;grid-template-columns:22px 1fr;gap:15px;align-items:center;padding:17px 0 17px 26px}.service-decision-matrix__answer>span{color:#FA001E;font-size:20px}.service-decision-matrix__answer p{margin:0;max-width:600px;font-size:14px;line-height:1.5;color:rgba(15,15,15,.76)}.service-decision-matrix__feature{align-self:stretch;display:flex;align-items:center;padding:24px 0 24px 24px;border-left:1px solid rgba(15,15,15,.18);font:700 clamp(23px,2.4vw,36px)/1 Steelfish,sans-serif;text-transform:uppercase;color:#BD0000}
@media(max-width:760px){.service-decision-matrix{grid-template-columns:1fr;gap:20px}.service-decision-matrix__feature{padding:18px 0 0;border-left:0;border-top:1px solid rgba(15,15,15,.18)}.service-decision-matrix__head{display:none}.service-decision-matrix__row{grid-template-columns:1fr;padding:18px 0;gap:8px}.service-decision-matrix__question{padding:0;grid-template-columns:28px 1fr}.service-decision-matrix__question h3{font-size:27px}.service-decision-matrix__answer{padding:0 0 0 40px;grid-template-columns:18px 1fr;gap:10px}.service-decision-matrix__answer p{font-size:13px}}
</style>
