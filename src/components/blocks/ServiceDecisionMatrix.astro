---
import type { ServiceCard } from './ServiceCardGrid.astro';
interface Props { items: ServiceCard[]; featuredTitle?: string; featuredText?: string; }
const { items, featuredTitle, featuredText } = Astro.props;
---
<div class="service-decision-matrix" role="table" aria-label="Как принимаем решения о распределении бюджета">
  <div class="service-decision-matrix__main">
  <div class="service-decision-matrix__head" role="row"><span role="columnheader">Что выясняем</span><span role="columnheader">Какое решение принимаем</span></div>
  {items.map((item, index) => <div class="service-decision-matrix__row" role="row">
    <div class="service-decision-matrix__question" role="cell"><span data-tl=""><span style="width:8px;height:8px;background:#FA001E;display:inline-block;flex:none"></span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3></div>
    <div class="service-decision-matrix__answer" role="cell"><span aria-hidden="true">→</span><p>{item.description}</p></div>
  </div>)}
  </div>
  {featuredTitle && <aside class="service-decision-matrix__feature"><h3>{featuredTitle}</h3>{featuredText && <p>{featuredText}</p>}</aside>}
</div>
<style is:global>
.service-decision-matrix{display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,.25fr);gap:30px;align-items:stretch}.service-decision-matrix__main{border-top:1px solid rgba(15,15,15,.25)}.service-decision-matrix__head,.service-decision-matrix__row{display:grid;grid-template-columns:minmax(0,49.5fr) minmax(0,50.5fr)}.service-decision-matrix__head{padding:0 0 13px 42px;font:500 9px 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:rgba(15,15,15,.55)}.service-decision-matrix__head span+span{padding-left:63px}.service-decision-matrix__row{position:relative;min-height:92px;align-items:center}.service-decision-matrix__row::after{content:"";position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:100vw;height:1px;background:#0F0F0F}.service-decision-matrix__question{display:grid;grid-template-columns:44px 1fr;gap:12px;align-items:center;padding:17px 22px 17px 0}.service-decision-matrix__question>span{display:flex;align-items:center;gap:10px;color:rgba(15,15,15,.5);font:500 13px/1.35 Onest,sans-serif}.service-decision-matrix__question h3{font:700 clamp(23px,2.3vw,34px)/.96 Steelfish,sans-serif;text-transform:uppercase;margin:0}.service-decision-matrix__answer{display:grid;grid-template-columns:22px 1fr;gap:15px;align-items:center;padding:17px 0 17px 26px}.service-decision-matrix__answer>span{color:#FA001E;font-size:20px}.service-decision-matrix__answer p{margin:0;max-width:600px;font-size:14px;line-height:1.5;color:rgba(15,15,15,.76)}.service-decision-matrix__feature{align-self:stretch;display:flex;flex-direction:column;justify-content:center;padding:24px 0 24px 24px;border-left:1px solid rgba(15,15,15,.18)}.service-decision-matrix__feature h3{font:700 clamp(23px,2.4vw,36px)/1 Steelfish,sans-serif;text-transform:uppercase;color:#BD0000;margin:0}.service-decision-matrix__feature p{font:400 14px/1.5 Onest,sans-serif;color:rgba(15,15,15,.76);margin:12px 0 0}
@media(max-width:760px){.service-decision-matrix{grid-template-columns:1fr;gap:20px}.service-decision-matrix__feature{padding:18px 0 0;border-left:0;border-top:1px solid rgba(15,15,15,.18)}.service-decision-matrix__head{display:none}.service-decision-matrix__row{grid-template-columns:1fr;padding:18px 0;gap:8px}.service-decision-matrix__question{padding:0;grid-template-columns:44px 1fr}.service-decision-matrix__question h3{font-size:27px}.service-decision-matrix__answer{padding:0 0 0 40px;grid-template-columns:18px 1fr;gap:10px}.service-decision-matrix__answer p{font-size:13px}}
</style>
<style is:global>
.service-decision-matrix__main{border-top:0}
.service-decision-matrix__head{padding-bottom:13px;font:500 9px var(--font-mono);text-transform:uppercase;color:rgba(15,15,15,.55);letter-spacing:.09em}
</style>
