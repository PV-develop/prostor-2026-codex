---
import SiteHeader from './SiteHeader.astro';
import HeroContent from './HeroContent.astro';
export interface ServiceCTA { label: string; href: string; }
interface Props {
  sections?: string[];
  title: string;
  accentText?: string;
  description: string;
  additionalLabel?: string;
  primaryCTA: ServiceCTA;
  secondaryCTA?: ServiceCTA;
  visualPreset?: 'performance' | 'static';
}
const { sections, title, accentText, description, additionalLabel, primaryCTA, secondaryCTA, visualPreset = 'static' } = Astro.props;
---
<section data-screen-label="01 Сервисный экран" data-service-hero data-visual-preset={visualPreset} style="position:relative;min-height:860px;display:grid;grid-template-rows:auto 1fr;overflow:hidden;color:#0F0F0F">
  <SiteHeader {sections} activeSection="services" />
  <div data-m="heropad" style="position:relative;padding:0 var(--gutter);display:flex;flex-direction:column;z-index:5">
    <div data-m="herogrid" style="position:relative;z-index:3;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;padding:108px 0 48px;align-items:start">
      <HeroContent description={description} className="service-hero__content" style={visualPreset === 'performance' ? 'grid-column:1/8;grid-row:1/4' : 'grid-column:1/10;grid-row:1/4'}>
        <Fragment slot="heading">{title}{accentText && <><br /><span style="color:#FA001E">{accentText}</span></>}</Fragment>
        <Fragment slot="actions">
          <a href={primaryCTA.href} style="background-image:linear-gradient(0deg,#FA001E 50%,#0F0F0F 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;color:#E9EBEF;padding:28px 36px;font:var(--type-button);letter-spacing:.14em;text-transform:uppercase;display:flex;gap:20px;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s" class="export-hover-127"><span class="service-hero__button-label">{primaryCTA.label}</span><span class="service-hero__button-icon">→</span></a>
          {secondaryCTA && <a href={secondaryCTA.href} style="border:1px solid rgba(15,15,15,.4);background-image:linear-gradient(0deg,#0F0F0F 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;padding:28px 28px;font:var(--type-button);letter-spacing:.14em;text-transform:uppercase;display:flex;gap:16px;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s,border-color .35s" class="export-hover-128"><span class="service-hero__button-label">{secondaryCTA.label}</span><span class="service-hero__button-icon">↗</span></a>}
        </Fragment>
      </HeroContent>
      {visualPreset === 'performance' && <div data-reveal data-m="twenty" style="grid-column:8/13;grid-row:1/4;justify-self:stretch;align-self:stretch;min-height:440px;position:relative;z-index:1;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:12px">
        {additionalLabel && <div data-cap style="position:absolute;z-index:6;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;text-align:center;pointer-events:none;white-space:nowrap;padding:0;background:transparent;backdrop-filter:none;-webkit-backdrop-filter:none;opacity:0"><span style="display:block;overflow:hidden;padding:0 4px"><span data-cap-line style="display:block;transform:translateY(110%);font:700 clamp(28px,2.8vw,40px)/1.04 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;color:#0F0F0F;white-space:nowrap">Используем собственную</span></span><span style="display:block;overflow:hidden;padding:0 4px"><span data-cap-line style="display:flex;justify-content:center;gap:10px;transform:translateY(110%);font:700 clamp(28px,2.8vw,40px)/1.04 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;color:#0F0F0F;white-space:nowrap"><span data-cap-plate style="display:inline-block;background:#FA001E;color:#E9EBEF;padding:0 8px;clip-path:inset(0 100% 0 0)">аналитику Prostor</span></span></span></div>}
        <span data-parallax data-particle-shape="pyramid" data-particle-color="#3A3D42" style="display:block;width:min(100%,480px);height:clamp(340px,40vw,520px);font:var(--type-hero-stat);font-stretch:25%;letter-spacing:-.04em;text-align:right;-webkit-text-fill-color:transparent;color:transparent;user-select:none">20</span>
      </div>}
    </div>
  </div>
</section>
<style is:global>
@media(max-width:1024px){
  [data-service-hero]{min-height:820px}
  [data-service-hero] [data-m="herogrid"]{grid-template-columns:repeat(8,minmax(0,1fr));padding:64px 0 48px 20px}
  [data-service-hero] .service-hero__content{grid-column:1/7!important;grid-row:1/4!important}
  [data-service-hero] [data-m="twenty"]{grid-column:6/9;grid-row:1/4}
  [data-service-hero] [data-cap]{margin-left:auto!important}
}
@media(max-width:768px){
  [data-service-hero]{min-height:0!important}
  [data-service-hero] [data-m="heropad"]{padding:0 20px!important}
  [data-service-hero] [data-m="herogrid"]{display:flex!important;flex-direction:column;align-items:stretch;padding:36px 0 48px!important;gap:32px}
  [data-service-hero] .service-hero__content{order:0;grid-column:auto!important;grid-row:auto!important}
  [data-service-hero] [data-m="twenty"]{order:1;align-self:stretch!important;min-height:340px!important;margin:0!important}
  [data-service-hero] [data-parallax]{height:340px!important}
}
@media(max-width:1100px){
  [data-service-hero] [data-actions-buttons]{width:100%;flex-direction:column;flex-wrap:nowrap;align-items:stretch;gap:12px}
  [data-service-hero] [data-actions-buttons]>a{box-sizing:border-box;flex:0 0 auto;width:100%;min-width:0;justify-content:space-between;white-space:nowrap}
  [data-service-hero] .service-hero__button-label{display:block;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
}
</style>
