---
interface Props {
  id?: string;
}

const { id = 'expert' } = Astro.props;
const titleId = `${id}-title`;
---
<section class="pm-expert" id={id} aria-labelledby={titleId}>
  <div class="pm-expert__grid">
    <div class="pm-expert__intro">
      <div class="pm-expert__faces" aria-hidden="true">
        <img src="/src/chips/expert-face-1.png" alt="" loading="lazy" />
        <img src="/src/chips/expert-face-2.png" alt="" loading="lazy" />
        <img src="/src/chips/expert-face-3.png" alt="" loading="lazy" />
      </div>
      <h2 class="page-display-heading" id={titleId}>Разберите свой проект<br />с экспертом</h2>
      <div class="pm-expert__contacts">
        <div class="pm-expert__contact">
          <span class="pm-expert__big">Мессенджеры</span>
          <div class="pm-expert__messengers">
            <a href="https://telegram.me/agency_prostor" target="_blank" rel="noopener noreferrer">Telegram <span>→</span></a>
            <a href="https://wa.me/79118270369" target="_blank" rel="noopener noreferrer">WhatsApp <span>→</span></a>
          </div>
        </div>
        <div class="pm-expert__contact">
          <a class="pm-expert__big" href="tel:88005555070">8 800 555-50-70</a>
          <span>Бесплатно по России</span>
        </div>
        <div class="pm-expert__contact">
          <a class="pm-expert__big" href="mailto:ork@prosto-r.ru">ork@prosto-r.ru</a>
          <span>Почта для заявок</span>
        </div>
      </div>
    </div>
    <form class="pm-expert__form" novalidate>
      <label class="pm-expert__field" data-field-group="EXN">
        <span data-field-label="EXN">Имя</span>
        <input type="text" name="name" autocomplete="name" data-field-input="EXN" />
      </label>
      <label class="pm-expert__field" data-field-group="EXP">
        <span data-field-label="EXP">Телефон</span>
        <input type="tel" name="phone" autocomplete="tel" data-field-input="EXP" />
      </label>
      <label class="pm-expert__field" data-field-group="EXE">
        <span data-field-label="EXE">Email</span>
        <input type="email" name="email" autocomplete="email" data-field-input="EXE" />
      </label>
      <label class="pm-expert__consent"><input type="checkbox" checked required /><span>Согласен на <a href="#">обработку персональных данных</a> и с <a href="#">политикой обработки персональных данных</a></span></label>
      <button type="submit" class="pm-expert__submit"><span>Отправить заявку</span><span aria-hidden="true">→</span></button>
    </form>
  </div>
</section>
<style is:global>
.pm-expert{background:#B62526;color:#E9EBEF;padding:var(--section-space-y) var(--gutter)}
.pm-expert__grid{display:grid;grid-template-columns:minmax(0,55fr) minmax(0,45fr);column-gap:clamp(40px,5vw,96px);align-items:start}
.pm-expert__faces{display:flex;margin-bottom:40px}
.pm-expert__faces img{width:84px;height:84px;border-radius:50%;object-fit:cover;border:2px solid #E9EBEF;box-sizing:border-box}
.pm-expert__faces img+img{margin-left:-21px}
.pm-expert__intro h2{margin:0 0 var(--section-content-gap)}
.pm-expert__contacts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px clamp(12px,1.6vw,48px);border-top:0;padding-top:0}
.pm-expert__contact{display:flex;flex-direction:column;gap:10px;min-width:0}
.pm-expert__contact>span:not(.pm-expert__big){font:var(--type-body);letter-spacing:0;text-transform:none;color:rgba(233,235,239,.9)}
.pm-expert__messengers{display:flex;flex-direction:row;gap:24px;align-items:flex-start;flex-wrap:wrap}
.pm-expert__messengers a{display:inline-flex;gap:10px;font:var(--type-button);letter-spacing:.1em;text-transform:uppercase;color:#E9EBEF;transition:color .2s}
.pm-expert__messengers a:hover{color:rgba(233,235,239,.7)}
.pm-expert__big{font:var(--type-contact);letter-spacing:.02em;color:#E9EBEF;transition:color .2s}
.pm-expert__contact:first-child>.pm-expert__big{text-transform:uppercase}
.pm-expert__big:hover{color:rgba(233,235,239,.7)}
.pm-expert__form{display:flex;flex-direction:column;padding-top:8px}
.pm-expert__field{position:relative;display:block;cursor:text;margin-bottom:34px}
.pm-expert__field span{position:absolute;left:0;top:20px;font:var(--type-body);color:rgba(233,235,239,.6);pointer-events:none;transition:top .2s,font-size .2s,color .2s}
.pm-expert__field input{all:unset;box-sizing:border-box;width:100%;height:56px;border-bottom:1px solid rgba(233,235,239,.45);color:#fff;font:var(--type-body);transition:border-color .25s}
.pm-expert__field input::placeholder{color:rgba(255,255,255,.7);opacity:1}
.pm-expert__field input:focus{border-color:#E9EBEF}
.pm-expert__field:focus-within span{top:0!important;font:var(--type-label);color:#E9EBEF}
.pm-expert__consent{display:flex;gap:12px;align-items:flex-start;cursor:pointer;margin:0 0 34px;font:var(--type-body-small);color:rgba(233,235,239,.85)}
.pm-expert__consent input{all:unset;flex:none;width:15px;height:15px;border:1px solid #E9EBEF;margin-top:2px;display:grid;place-content:center;cursor:pointer}
.pm-expert__consent input:checked{background:#0F0F0F;border-color:#0F0F0F}
.pm-expert__consent input:checked::after{content:"";width:7px;height:7px;background:#E9EBEF}
.pm-expert__consent a{color:inherit;text-decoration:underline;text-underline-offset:3px}
.pm-expert__submit{all:unset;box-sizing:border-box;display:flex;justify-content:space-between;align-items:center;height:64px;padding:0 26px;background:#0F0F0F;color:#E9EBEF;font:var(--type-button);letter-spacing:.12em;text-transform:uppercase;cursor:pointer;background-image:linear-gradient(0deg,#E9EBEF 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s}
.pm-expert__submit:hover{background-position:0 100%;color:#0F0F0F}
@media(max-width:1000px){.pm-expert{padding-block:var(--section-space-y);padding-inline:var(--gutter)}.pm-expert__grid{grid-template-columns:1fr;row-gap:48px}.pm-expert__intro{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);column-gap:24px;row-gap:24px;align-items:start}.pm-expert__faces{grid-column:1;grid-row:1;margin-bottom:0}.pm-expert__intro h2{grid-column:1;grid-row:2;margin-bottom:0}.pm-expert__contacts{grid-column:2;grid-row:1/3;grid-template-columns:minmax(0,1fr);gap:18px}}
@media(max-width:680px){.pm-expert{padding:var(--section-space-y) var(--gutter)}.pm-expert__intro{column-gap:16px;row-gap:20px}.pm-expert__contacts{gap:var(--space-5)}.pm-expert__contact{gap:6px}.pm-expert__messengers{column-gap:12px;row-gap:8px}}
</style>
