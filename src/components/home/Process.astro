---
import ProcessLead from './ProcessLead.astro';
import ProcessCards from '../blocks/ProcessCards.astro';

const processItems = [
  { title: 'Разбираем ситуацию', description: 'Аудит текущего продвижения, сайта, воронки, аналитики и конкурентов', duration: '1–2 недели', label: 'Вы получаете', detail: 'Карта ограничений и точек роста' },
  { title: 'Формируем приоритеты', description: 'Определяем задачи, точки роста, гипотезы и ожидаемый эффект', duration: '1 неделя', label: 'Вы получаете', detail: 'План с очерёдностью и прогнозом' },
  { title: 'Запускаем работу', description: 'Реализуем выбранные направления: performance, SEO, AI, репутация, сайт', duration: '2–4 недели', label: 'Вы получаете', detail: 'Работающие каналы и ответственные' },
  { title: 'Измеряем и корректируем', description: 'Отслеживаем показатели, проверяем гипотезы, пересматриваем план', duration: 'Каждый месяц', label: 'Вы получаете', detail: 'Отчёт и обновлённый план' },
  { title: 'Масштабируем то, что работает', description: 'Усиливаем эффективные каналы и решения', duration: 'Постоянно', label: 'Вы получаете', detail: 'Рост на проверенных каналах' },
];
---
<div data-screen-label="04 Как работаем" id="process" data-page-nav style="position:relative;padding:var(--section-space-y) 0">
<div data-reveal="" data-m="s4head" class="section-heading-pair" style="padding:0 var(--gutter)"><h2 class="section-heading-pair__title">Как мы<br>выстраиваем <span style="-webkit-text-stroke:2px #0F0F0F;color:transparent">работу</span></h2><p class="section-heading-pair__subtitle" style="color:rgba(15,15,15,.74);max-width:620px">Пять этапов — от диагностики до масштабирования. На каждом вы заранее знаете, что делаем, сколько это занимает и что получаете в итоге.</p></div>
<div data-m="prochint" style="display:none;align-items:center;gap:10px;font:var(--type-label);letter-spacing:.04em;text-transform:uppercase;color:rgba(15,15,15,.6)"><span>5 этапов · листайте</span><span style="display:flex;width:28px;height:1px;background:currentColor;position:relative"></span><span style="margin-left:-12px">→</span></div>
<div style="margin-top:var(--section-content-gap)"><ProcessCards items={processItems} carousel /></div>

<div data-reveal="" data-m="procnote" style="margin:8px var(--gutter) 0;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px;font:var(--type-body);color:rgba(15,15,15,.6)"><span>Первые каналы запускаем через 4–7 недель</span><span>Отчёт и обновлённый план — ежемесячно</span></div>
</div>
<ProcessLead />
