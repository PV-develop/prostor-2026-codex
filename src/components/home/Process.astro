---
import ProcessLead from './ProcessLead.astro';
import ProcessCards from '../blocks/ProcessCards.astro';

const processItems = [
  { title: 'Разбираем ситуацию', description: 'Аудит текущего продвижения, сайта, воронки, аналитики и конкурентов', duration: '1–2 недели', label: 'Вы получаете', detail: 'Карта ограничений и точек роста' },
  { title: 'Формируем приоритеты', description: 'Определяем задачи, точки роста, гипотезы и ожидаемый эффект', duration: '1 неделя', label: 'Вы получаете', detail: 'План с очерёдностью и прогнозом' },
  { title: 'Запускаем работу', description: 'Реализуем выбранные направления: performance, SEO, AI, репутация, сайт', duration: '2–4 недели', label: 'Вы получаете', detail: 'Работающие каналы и ответственные' },
  { title: 'Измеряем и корректируем', description: 'Отслеживаем показатели, проверяем гипотезы, пересматриваем план', duration: 'Каждый месяц', label: 'Вы получаете', detail: 'Отчёт и обновлённый план' },
  { title: 'Масштабируем то, что работает', description: 'Усиливаем эффективные каналы и решения', duration: 'Постоянно', label: 'Вы получаете', detail: 'Рост на проверенных каналах' },
];
---
<div data-screen-label="04 Как работаем" id="process" style="position:relative;padding:140px 0 0;background:#E9EBEF">
<div data-reveal="" data-m="s4head" style="padding:0 48px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px 48px"><div style="display:flex;gap:20px"><div style="font:500 13px/1.35 Onest,sans-serif;color:#BD0000;writing-mode:vertical-rl;transform:rotate(180deg);display:flex;gap:12px;align-items:center;align-self:flex-start;flex:none">04 — Процесс<span style="width:8px;height:8px;background:#FA001E;display:inline-block"></span></div><h2 style="margin:0;font:700 clamp(48px,6vw,96px)/.9 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase">Как мы<br>выстраиваем <span style="-webkit-text-stroke:2px #0F0F0F;color:transparent">работу</span></h2></div><div style="font-size:16px;line-height:1.5;color:rgba(15,15,15,.74);max-width:460px;text-wrap:pretty">Пять этапов — от диагностики до масштабирования. На каждом вы заранее знаете, что делаем, сколько это занимает и что получаете в итоге.</div></div>
<div data-m="prochint" style="display:none;align-items:center;gap:10px;font:500 13px/1 Onest,sans-serif;letter-spacing:.04em;text-transform:uppercase;color:rgba(15,15,15,.6)"><span>5 этапов · листайте</span><span style="display:flex;width:28px;height:1px;background:currentColor;position:relative"></span><span style="margin-left:-12px">→</span></div>
<div style="margin-top:80px" data-m="proc"><ProcessCards items={processItems} /></div>

<div data-reveal="" data-m="procnote" style="margin:8px 48px 0;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 32px;font:400 15px/1.5 Onest,sans-serif;color:rgba(15,15,15,.6)"><span>Первые каналы запускаем через 4–7 недель</span><span>Отчёт и обновлённый план — ежемесячно</span></div>
</div>
<ProcessLead />
