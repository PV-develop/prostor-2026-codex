---
import { featuredCases, resolveCases } from '../../data/cases';
import type { CaseCard } from '../../content/schema';
interface Props { items?: CaseCard[]; id?: string; cta?: { label: string; href: string } | null }
const { id = 'cases', cta = { label: 'Все кейсы', href: '#' } } = Astro.props;
const items = Astro.props.items ?? await resolveCases(featuredCases, Astro.url.pathname);
---
<div data-screen-label="03 Кейсы" id={id} data-page-nav style="background:#0F0F0F;color:#E9EBEF;padding:var(--section-space-y) 0;overflow:hidden">
<div data-reveal="" data-m="sechead" style="padding:0 var(--gutter);display:flex;justify-content:space-between;align-items:end;gap:var(--section-heading-gap)"><h2 style="margin:0;"><slot name="heading">Задачи бизнеса,<br><span style="-webkit-text-stroke:2px #E9EBEF;color:transparent">которые уже</span> решили</slot></h2>{cta && <a href={cta.href} style="border:1px solid rgba(233,235,239,.4);background-image:linear-gradient(0deg,#E9EBEF 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;padding:24px 28px;font:var(--type-button);letter-spacing:.14em;text-transform:uppercase;display:flex;gap:20px;white-space:nowrap;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s,border-color .35s;margin-bottom:12px" class="export-hover-54">{cta.label} <span>→</span></a>}</div>

<div style="margin-top:var(--section-content-gap);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2px;padding:0 var(--gutter)" data-m="cases">
{items.map((item) => (
  <a href={item.href} data-reveal="" style="position:relative;background:#1a1a1a;color:#E9EBEF;display:flex;flex-direction:column;overflow:hidden;transition:transform .5s" class="export-hover-55">
    <div data-gs-photo="" style="position:relative;height:360px;flex:none;overflow:hidden;filter:brightness(.7)"><image-slot id={item.slotId} src={item.image} shape="rect" placeholder={item.placeholder}></image-slot></div>
    <div data-gs="" style="position:absolute;inset:0;backdrop-filter:grayscale(1) brightness(.78);-webkit-backdrop-filter:grayscale(1) brightness(.78);clip-path:inset(0 0 0 0);transition:clip-path .7s cubic-bezier(.7,0,.2,1);pointer-events:none"></div>
    <div style="position:relative;padding:24px;display:flex;justify-content:space-between;align-items:center;font:600 12px/1.2 Onest,sans-serif;letter-spacing:.01em;text-transform:uppercase;pointer-events:none"><span style="background:#FA001E;color:#0F0F0F;padding:6px 10px">{item.label}</span><span style="">{item.sector}</span></div>
    <div class="case-card__content">
    <div class="case-card__metric">
    <div class="case-card__value">+<span data-count={item.value}>0</span><span style="color:#FA001E;font-size:.55em">%</span></div>
    <div class="case-card__metric-label">{item.metric}</div></div><h3 class="case-card__title">{item.title}</h3><p class="case-card__description">{item.description}</p></div></a>
))}

</div>
</div>

<style>
.case-card__content{position:relative;padding:0 24px 28px;color:#E9EBEF;pointer-events:none}
.case-card__metric{display:flex;align-items:flex-end;gap:12px;min-height:1.5em}
.case-card__value{font:var(--type-metric);white-space:nowrap}
.case-card__metric-label,.case-card__description{font:var(--type-body);letter-spacing:0;color:#E9EBEF}
.case-card__metric-label{opacity:1}
.case-card__title{margin:24px 0 0;padding:0;border:0}
.case-card__description{opacity:1;margin:10px 0 0}
@media(max-width:1100px){.case-card__metric{gap:10px}}
@media(max-width:680px){.case-card__metric-label,.case-card__description{font:var(--type-body)}}
</style>
