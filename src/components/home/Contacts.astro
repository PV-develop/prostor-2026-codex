---
import { contactDetails, defaultBrief } from '../../data/site-contacts';
import Footer from './Footer.astro';
interface Props {
  submitLabel?: string;
  brief?: { heading: string; secondLine?: string; description: string; cta: { label: string; href: string } };
}
const { submitLabel = 'Отправить заявку', brief = defaultBrief } = Astro.props;
---
<div data-screen-label="06 Контакты" id="contacts" data-page-nav style="background:#0F0F0F;color:#E9EBEF;padding:var(--section-space-y) 0;overflow:hidden">
<div data-reveal="" data-m="contacts" style="padding:0 var(--gutter);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:0">
<form class="contacts-form" style="margin:0;background:#BD0000;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:28px" data-action-submit="onSend">
<div class="section-heading-pair contacts-heading-pair"><h2 class="section-heading-pair__title contacts-form__title"><slot name="heading">Оставьте заявку, чтобы <span>обсудить проект</span></slot></h2><p class="section-heading-pair__subtitle" style="color:rgba(233,235,239,.86);max-width:440px"><slot name="description">Свяжемся в течение часа и проконсультируем по вашему вопросу.</slot></p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(max(220px,calc(50% - 6px)),1fr));gap:12px">
<label style="position:relative;display:block;cursor:text;grid-column:1/-1" data-field-group="CN"><span style="position:absolute;left:18px;top:20px;font:var(--type-body);color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CN">Имя</span><input type="text" value="" style="all:unset;box-sizing:border-box;width:100%;height:60px;padding:22px 18px 0;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:var(--type-body);transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CN" data-action-change="onCN" data-action-focus="focCN" data-action-blur="blurCN"></label>
<label style="position:relative;display:block;cursor:text" data-field-group="CE"><span style="position:absolute;left:18px;top:20px;font:var(--type-body);color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CE">Почта</span><input type="email" value="" style="all:unset;box-sizing:border-box;width:100%;height:60px;padding:22px 18px 0;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:var(--type-body);transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CE" data-action-change="onCE" data-action-focus="focCE" data-action-blur="blurCE"></label>
<label style="position:relative;display:block;cursor:text" data-field-group="CP"><span style="position:absolute;left:18px;top:20px;font:var(--type-body);color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CP">Телефон</span><input type="tel" value="" placeholder="" style="all:unset;box-sizing:border-box;width:100%;height:60px;padding:22px 18px 0;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:var(--type-body);transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CP" data-action-change="onCP" data-action-focus="focCP" data-action-blur="blurCP"></label>
<label style="position:relative;display:block;cursor:text;grid-column:1/-1" data-field-group="CM"><span style="position:absolute;left:18px;top:20px;font:var(--type-body);color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CM">Опишите задачу</span><textarea rows="4" style="all:unset;box-sizing:border-box;display:block;width:100%;min-height:136px;padding:30px 18px 14px;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:var(--type-body);white-space:pre-wrap;transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CM" data-action-change="onCM" data-action-focus="focCM" data-action-blur="blurCM"></textarea></label>
<label style="grid-column:1/-1;display:flex;align-items:center;gap:16px;min-height:60px;padding:12px 18px;box-sizing:border-box;border:1px dashed rgba(233,235,239,.32);cursor:pointer;transition:border-color .25s" class="export-hover-60"><input type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt" style="display:none" data-action-change="onFile"><svg viewBox="0 0 24 24" fill="none" stroke="#FA001E" stroke-width="2" stroke-linecap="square" style="width:20px;height:20px;flex:none"><path d="M20 11.5l-8.2 8.2a5 5 0 01-7.1-7.1l8.5-8.5a3.3 3.3 0 014.7 4.7l-8.5 8.5a1.7 1.7 0 01-2.4-2.4l7.8-7.8"></path></svg><span style="display:flex;flex-direction:column;gap:4px;min-width:0"><span style="font:var(--type-ui-emphasis);color:#E9EBEF;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Приложить бриф или документ</span><span style="font:400 12px/1.3 Onest,sans-serif;color:rgba(233,235,239,.5)">PDF, DOC, XLS, PPT — до 20 МБ</span></span></label>
</div>
<div style="display:flex;flex-direction:column;gap:14px"><button type="submit" style="all:unset;box-sizing:border-box;cursor:pointer;background:#0F0F0F;color:#FFFFFF;padding:24px 28px;font:var(--type-button);letter-spacing:.14em;text-transform:uppercase;display:flex;justify-content:space-between;gap:20px;transition:background .25s" class="contacts-submit"><span>{submitLabel}</span><span>→</span></button><div style="font:var(--type-body-small);color:rgba(233,235,239,.72)">Отправляя заявку, вы соглашаетесь с <a href="#" style="color:rgba(233,235,239,.95);text-decoration:underline;text-underline-offset:3px">политикой обработки персональных данных</a></div></div>
</form>
<div class="contacts-form__aside" style="display:grid;grid-template-rows:auto 1fr;gap:0;min-width:0">
<div class="contacts-form__brief" style="background:#E9EBEF;color:#0F0F0F;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:28px"><div style="display:flex;flex-direction:column;gap:16px"><h3 class="contacts-card-heading" style="margin:0;text-transform:uppercase;text-wrap:balance">{brief.heading}{brief.secondLine && <><br />{brief.secondLine}</>}</h3><p style="margin:0;font:var(--type-body);max-width:420px;text-wrap:pretty">{brief.description}</p></div><a href={brief.cta.href} style="align-self:flex-start;border:1px solid #0F0F0F;background-image:linear-gradient(0deg,#0F0F0F 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;color:#0F0F0F;padding:22px 28px;font:var(--type-button);letter-spacing:.14em;text-transform:uppercase;display:flex;gap:20px;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s" class="contacts-brief-cta">{brief.cta.label} <span>→</span></a></div>
<div class="contacts-form__contact-card" style="background:#242526;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:32px"><h3 class="contacts-card-heading" style="margin:0;text-transform:uppercase">Контакты</h3>
<div class="contacts-form__contact-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 32px;align-items:start">
<a href={contactDetails.phone.href} style="display:flex;flex-direction:column;gap:6px;color:#E9EBEF;transition:color .25s" class="export-hover-63"><span style="font:var(--type-contact);font-stretch:25%">{contactDetails.phone.label}</span><span style="font:var(--type-body-small);color:rgba(233,235,239,.5)">Бесплатно по России</span></a>
<a href={contactDetails.office.href} style="display:flex;flex-direction:column;gap:6px;color:#E9EBEF;transition:color .25s" class="export-hover-64"><span style="font:var(--type-contact);font-stretch:25%">{contactDetails.office.label}</span><span style="font:var(--type-body-small);color:rgba(233,235,239,.5)">Санкт-Петербург, Липовая аллея, 9</span></a>
<a href={contactDetails.email.href} style="display:flex;flex-direction:column;gap:6px;color:#E9EBEF;transition:color .25s" class="export-hover-65"><span style="font:var(--type-contact);font-stretch:25%">{contactDetails.email.label}</span><span style="font:var(--type-body-small);color:rgba(233,235,239,.5)">Почта для заявок</span></a>
<div class="contacts-form__messengers" style="display:grid;grid-template-rows:max-content max-content;row-gap:6px;align-content:start;align-self:start;height:max-content;min-width:0"><h3 class="contacts-card-heading">Мессенджеры</h3><div class="contacts-form__social-links"><a class="contacts-form__social-link" href="#"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M14.7 2.1 12.6 13c-.16.77-.62.96-1.25.6l-3.44-2.54-1.66 1.6c-.18.18-.34.34-.7.34l.25-3.5 6.36-5.75c.28-.25-.06-.4-.43-.15L3.87 8.72.5 7.67c-.73-.23-.75-.73.15-1.08L13.8 1.5c.6-.22 1.13.15.9.6Z" /></svg>Telegram</a><a class="contacts-form__social-link" href="#"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13.6 2.4A6.9 6.9 0 0 0 2.7 10.7L2 14l3.4-.7a6.9 6.9 0 0 0 8.2-10.9Z"/><path d="M5.1 4.8c.2-.4.4-.4.7-.4h.4c.1 0 .3 0 .4.3l.6 1.4c.1.2 0 .4-.1.5l-.4.5c-.1.1-.2.3 0 .5.2.4.7 1.1 1.4 1.6.8.6 1.4.8 1.7.9.2.1.4 0 .5-.1l.6-.7c.1-.2.3-.2.5-.1l1.3.6c.2.1.3.2.3.3 0 .2-.1.8-.5 1.1-.4.4-1 .6-1.6.5-.5-.1-1.2-.3-2.1-.7-1.2-.5-2.1-1.3-2.8-2.1-.7-.8-1.2-1.7-1.4-2.4-.2-.8.1-1.4.5-1.7Z"/></svg>WhatsApp</a></div></div>
</div></div>
</div>
</div>

<style is:global>

#contacts .contacts-form__title span{color:#E9EBEF!important}


#contacts .contacts-form__messengers>.contacts-card-heading{margin:0}
#contacts .contacts-card-heading{font:var(--type-h3);font-stretch:var(--display-stretch);text-transform:uppercase}
#contacts .contacts-heading-pair{grid-template-columns:minmax(0,1fr);row-gap:var(--space-4);align-items:start}
#contacts .contacts-heading-pair>.contacts-form__title,#contacts .contacts-heading-pair>.section-heading-pair__subtitle{grid-column:1}
#contacts .contacts-heading-pair>.section-heading-pair__subtitle{align-self:start;max-width:440px;font:var(--type-body)}
#contacts .contacts-form label[data-field-group]>span{left:0!important;color:rgba(255,255,255,.65)!important}
#contacts .contacts-form input:not([type="file"]),#contacts .contacts-form textarea{background:transparent!important;border:0!important;border-bottom:1px solid rgba(255,255,255,.58)!important;border-radius:0!important;padding-left:0!important;padding-right:0!important;color:#fff!important}
#contacts .contacts-form input:focus,#contacts .contacts-form textarea:focus{border-bottom-color:#fff!important}
#contacts .contacts-form input::placeholder,#contacts .contacts-form textarea::placeholder{color:rgba(255,255,255,.7);opacity:1}
#contacts .contacts-submit:hover{background:#252525!important}
#contacts .contacts-brief-cta:hover{background-position:0 100%!important;color:#E9EBEF!important}
#contacts .contacts-form__messengers{display:grid;grid-template-rows:auto auto;row-gap:6px;align-content:start;min-width:0}
#contacts .contacts-form__contact-grid{align-items:start!important}
#contacts .contacts-form__social-links{display:flex;align-items:center;gap:24px;flex-wrap:wrap}
#contacts .contacts-form__social-link{display:inline-flex;align-items:center;gap:7px;color:#E9EBEF;font:var(--type-button);letter-spacing:.14em;text-transform:uppercase;transition:color .2s}
#contacts .contacts-form__social-link:hover{color:rgba(233,235,239,.7)}
#contacts .contacts-form__social-link svg{width:12px;height:12px;flex:none;fill:none;stroke:currentColor;stroke-width:1.1;stroke-linecap:round;stroke-linejoin:round}
#contacts .contacts-form__social-link:first-child svg{fill:currentColor;stroke:none}
@media(max-width:520px){#contacts .contacts-form__contact-grid{grid-template-columns:1fr!important;gap:22px}}
</style>

<Footer />
</div>
