---
import Footer from './Footer.astro';
---
<div data-screen-label="06 Контакты" id="contacts" style="background:#0F0F0F;color:#E9EBEF;padding:60px 0 48px;overflow:hidden">
<div data-tl="h" style="margin:0 var(--gutter) 40px;width:max-content;font:500 13px/1.35 Onest,sans-serif;letter-spacing:0;color:#FA001E;display:flex;gap:12px;align-items:center;clip-path:inset(0 100% 0 0);transition:clip-path .6s cubic-bezier(.7,0,.2,1) .2s"><span style="width:8px;height:8px;background:#FA001E;display:inline-block"></span>Контакты</div>
<div data-reveal="" data-m="contacts" style="padding:0 var(--gutter);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr));gap:2px">
<form style="margin:0;background:#1A1A1A;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:28px" data-action-submit="onSend">
<div style="display:flex;flex-direction:column;gap:16px"><h2 style="margin:0;font:700 clamp(44px,4.6vw,68px)/.92 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;text-wrap:balance">Оставьте заявку, чтобы <span style="color:#FA001E">обсудить проект</span></h2><p style="margin:0;font-size:16px;line-height:1.5;color:rgba(233,235,239,.72);max-width:440px;text-wrap:pretty">Свяжемся в течение часа и проконсультируем по вашему вопросу.</p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(max(220px,calc(50% - 6px)),1fr));gap:12px">
<label style="position:relative;display:block;cursor:text;grid-column:1/-1" data-field-group="CN"><span style="position:absolute;left:18px;top:20px;font:400 16px Onest,sans-serif;color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CN">Имя</span><input type="text" value="" style="all:unset;box-sizing:border-box;width:100%;height:60px;padding:22px 18px 0;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:400 16px Onest,sans-serif;transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CN" data-action-change="onCN" data-action-focus="focCN" data-action-blur="blurCN"></label>
<label style="position:relative;display:block;cursor:text" data-field-group="CE"><span style="position:absolute;left:18px;top:20px;font:400 16px Onest,sans-serif;color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CE">Почта</span><input type="email" value="" style="all:unset;box-sizing:border-box;width:100%;height:60px;padding:22px 18px 0;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:400 16px Onest,sans-serif;transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CE" data-action-change="onCE" data-action-focus="focCE" data-action-blur="blurCE"></label>
<label style="position:relative;display:block;cursor:text" data-field-group="CP"><span style="position:absolute;left:18px;top:20px;font:400 16px Onest,sans-serif;color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CP">Телефон</span><input type="tel" value="" placeholder="" style="all:unset;box-sizing:border-box;width:100%;height:60px;padding:22px 18px 0;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:400 16px Onest,sans-serif;transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CP" data-action-change="onCP" data-action-focus="focCP" data-action-blur="blurCP"></label>
<label style="position:relative;display:block;cursor:text;grid-column:1/-1" data-field-group="CM"><span style="position:absolute;left:18px;top:20px;font:400 16px Onest,sans-serif;color:rgba(233,235,239,.55);pointer-events:none;transition:top .2s,font-size .2s" data-field-label="CM">Опишите задачу</span><textarea rows="4" style="all:unset;box-sizing:border-box;display:block;width:100%;min-height:136px;padding:30px 18px 14px;background:#0F0F0F;border:1px solid rgba(233,235,239,.22);color:#E9EBEF;font:400 16px/1.5 Onest,sans-serif;white-space:pre-wrap;transition:border-color .25s" style-focus="border-color:#E9EBEF" data-field-input="CM" data-action-change="onCM" data-action-focus="focCM" data-action-blur="blurCM"></textarea></label>
<label style="grid-column:1/-1;display:flex;align-items:center;gap:16px;min-height:60px;padding:12px 18px;box-sizing:border-box;border:1px dashed rgba(233,235,239,.32);cursor:pointer;transition:border-color .25s" class="export-hover-60"><input type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt" style="display:none" data-action-change="onFile"><svg viewBox="0 0 24 24" fill="none" stroke="#FA001E" stroke-width="2" stroke-linecap="square" style="width:20px;height:20px;flex:none"><path d="M20 11.5l-8.2 8.2a5 5 0 01-7.1-7.1l8.5-8.5a3.3 3.3 0 014.7 4.7l-8.5 8.5a1.7 1.7 0 01-2.4-2.4l7.8-7.8"></path></svg><span style="display:flex;flex-direction:column;gap:4px;min-width:0"><span style="font:500 15px/1.3 Onest,sans-serif;color:#E9EBEF;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Приложить бриф или документ</span><span style="font:400 12px/1.3 Onest,sans-serif;color:rgba(233,235,239,.5)">PDF, DOC, XLS, PPT — до 20 МБ</span></span></label>
</div>
<div style="display:flex;flex-direction:column;gap:14px"><button type="submit" style="all:unset;box-sizing:border-box;cursor:pointer;background-image:linear-gradient(90deg,#E9EBEF 50%,#FA001E 50%);background-size:201% 100%;background-position:100% 0;background-repeat:no-repeat;color:#FFFFFF;padding:24px 28px;font:600 12px 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase;display:flex;justify-content:space-between;gap:20px;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s" class="export-hover-61"><span>Отправить заявку</span><span>→</span></button><div style="font-size:12px;line-height:1.5;color:rgba(233,235,239,.5)">Отправляя заявку, вы соглашаетесь с <a href="#" style="color:rgba(233,235,239,.8);text-decoration:underline;text-underline-offset:3px">политикой обработки персональных данных</a></div></div>
</form>
<div style="display:grid;grid-template-rows:auto 1fr;gap:2px;min-width:0">
<div style="background:#E9EBEF;color:#0F0F0F;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:28px"><div style="display:flex;flex-direction:column;gap:16px"><h3 style="margin:0;font:700 clamp(36px,3.6vw,52px)/.92 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;text-wrap:balance">Или сразу заполните бриф из 5 вопросов</h3><p style="margin:0;font-size:16px;line-height:1.5;max-width:420px;text-wrap:pretty">Чем раньше мы поймём задачу, тем точнее подготовим предложение.</p></div><a href="#" style="align-self:flex-start;background-image:linear-gradient(90deg,#FA001E 50%,#0F0F0F 50%);background-size:201% 100%;background-position:100% 0;background-repeat:no-repeat;color:#FFFFFF;padding:22px 28px;font:600 12px 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase;display:flex;gap:20px;transition:background-position .55s cubic-bezier(.7,0,.2,1)" class="export-hover-62">Заполнить бриф <span>→</span></a></div>
<div style="background:#1A1A1A;padding:clamp(32px,4vw,56px);display:flex;flex-direction:column;gap:32px"><h3 style="margin:0;font:700 clamp(36px,3.6vw,52px)/.92 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase">Контакты</h3>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:28px 32px">
<a href="tel:88005555070" style="display:flex;flex-direction:column;gap:6px;color:#E9EBEF;transition:color .25s" class="export-hover-63"><span style="font:700 clamp(28px,2.6vw,36px)/1 Steelfish,sans-serif;font-stretch:25%">8 800 555-50-70</span><span style="font-size:13px;line-height:1.4;color:rgba(233,235,239,.5)">Бесплатно по России</span></a>
<a href="tel:88126400709" style="display:flex;flex-direction:column;gap:6px;color:#E9EBEF;transition:color .25s" class="export-hover-64"><span style="font:700 clamp(28px,2.6vw,36px)/1 Steelfish,sans-serif;font-stretch:25%">8 812 640-07-09</span><span style="font-size:13px;line-height:1.4;color:rgba(233,235,239,.5)">Санкт-Петербург, Липовая аллея, 9</span></a>
<a href="mailto:ork@prosto-r.ru" style="display:flex;flex-direction:column;gap:6px;color:#E9EBEF;transition:color .25s" class="export-hover-65"><span style="font:700 clamp(28px,2.6vw,36px)/1 Steelfish,sans-serif;font-stretch:25%">ork@prosto-r.ru</span><span style="font-size:13px;line-height:1.4;color:rgba(233,235,239,.5)">Почта для заявок</span></a>
<div style="display:flex;flex-direction:column;gap:10px"><span style="font-size:13px;line-height:1.4;color:rgba(233,235,239,.5)">Написать в мессенджер</span><div style="display:flex;gap:2px;flex-wrap:wrap"><a href="#" style="border:1px solid rgba(233,235,239,.32);padding:12px 16px;font:600 11px 'JetBrains Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#E9EBEF;transition:background .25s,color .25s" class="export-hover-66">Telegram</a><a href="#" style="border:1px solid rgba(233,235,239,.32);padding:12px 16px;font:600 11px 'JetBrains Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#E9EBEF;transition:background .25s,color .25s" class="export-hover-67">WhatsApp</a></div></div>
</div></div>
</div>
</div>

<Footer />
</div>
