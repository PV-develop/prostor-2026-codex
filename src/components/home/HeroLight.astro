---
import SiteHeader from '../blocks/SiteHeader.astro';
// Light hero — the design-system choice for all pages: same markup rhythm,
// adaptive behaviour and interactions as the retired dark Hero.astro (kept
// for rollback), but no background (page paper + dot field show through),
// ink typography and dark-gray particles via data-particle-color.
---
<div data-screen-label="01 Первый экран" style="color:#0F0F0F;position:relative;min-height:860px;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden">
<SiteHeader />
<div data-m="heropad" style="position:relative;padding:0 var(--gutter);display:flex;flex-direction:column">
<div style="position:relative;z-index:3;display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;padding:132px 0 56px;align-items:start" data-m="herogrid">
<h1 class="page-display-heading" data-reveal="" style="margin:0;font:700 clamp(64px,9.6vw,152px)/1.06 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;letter-spacing:-.005em;grid-column:1/9;grid-row:1;text-wrap:balance;position:relative;z-index:2">Разгоняем<br><span style="position:relative">маркетинг,<span data-m="lead" style="position:absolute;left:calc(100% + .3em);top:-.66em;width:min(340px,22vw)"><span style="display:block;font:400 clamp(15px,1.2vw,18px)/1.45 Onest,sans-serif;font-stretch:100%;text-transform:none;letter-spacing:0;color:rgba(15,15,15,.86);text-wrap:pretty;text-align:left">Объединяем стратегию, продвижение, разработку и аналитику в единую систему, чтобы привлекать целевые обращения, повышать конверсию и понимать, какие вложения приносят результат</span></span></span><br><span style="color:#FA001E">вникаем</span> в бизнес<span style="color:#FA001E">.</span></h1><p data-m="leadm" style="display:none;margin:0;font:400 17px/1.5 Onest,sans-serif;color:rgba(15,15,15,.86);text-wrap:pretty;max-width:520px">Объединяем стратегию, продвижение, разработку и аналитику в единую систему, чтобы привлекать целевые обращения, повышать конверсию и понимать, какие вложения приносят результат</p>
<div data-reveal="" data-m="twenty" style="grid-column:9/13;grid-row:1;justify-self:end;align-self:end;margin-bottom:.02em;display:flex;flex-direction:column;align-items:flex-end;gap:28px;position:relative;z-index:1;font-size:clamp(84px,11.7vw,168px)"><div data-cap="" style="position:relative;z-index:5;display:flex;flex-direction:column;align-items:flex-end;text-align:right;pointer-events:none;padding:16px 22px;background:rgba(233,235,239,.62);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:0"><span style="display:block;overflow:hidden;padding:0 4px"><span data-cap-line="" style="display:block;transform:translateY(110%);font:700 clamp(28px,2.8vw,40px)/1.04 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;color:#0F0F0F;white-space:nowrap">Лет в чужом бизнесе</span></span><span style="display:block;overflow:hidden;padding:0 4px"><span data-cap-line="" style="display:flex;gap:10px;transform:translateY(110%);font:700 clamp(28px,2.8vw,40px)/1.04 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;color:#0F0F0F;white-space:nowrap"><span data-cap-plate="" style="display:inline-block;background:#FA001E;color:#E9EBEF;padding:0 8px;clip-path:inset(0 100% 0 0)">как в своём</span></span></span></div><div data-parallax="" data-particle-color="#3A3D42" style="font:800 clamp(220px,30vw,440px)/.72 Steelfish,sans-serif;font-stretch:25%;letter-spacing:-.04em;text-align:right;-webkit-text-fill-color:transparent;color:transparent;user-select:none">20</div></div>
<div data-reveal="" data-m="herocta" style="grid-column:1/8;grid-row:2;align-self:start;margin-top:56px;display:flex;flex-direction:column;gap:36px;max-width:620px"><div style="display:flex;gap:20px;flex-wrap:wrap"><a href="#" style="background-image:linear-gradient(0deg,#FA001E 50%,#0F0F0F 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;color:#E9EBEF;padding:28px 36px;font:600 12px 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase;display:flex;gap:20px;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s" class="export-hover-127">Обсудить задачу <span>→</span></a><a href="#" style="border:1px solid rgba(15,15,15,.4);background-image:linear-gradient(0deg,#0F0F0F 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;padding:28px 28px;font:600 12px 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase;display:flex;gap:16px;transition:background-position .55s cubic-bezier(.7,0,.2,1),color .35s,border-color .35s" class="export-hover-128">Кейсы <span>↓</span></a></div></div>
</div>
</div>

<div data-m="trust" style="position:relative;z-index:4;margin:0 var(--gutter);border-top:1px solid rgba(15,15,15,.14);padding:22px 0 26px;display:grid;grid-template-columns:minmax(0,1fr);align-items:center"><div style="overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)"><div style="display:flex;gap:44px;align-items:center;width:max-content;animation:marq 40s linear infinite;font:700 30px/1 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;color:rgba(15,15,15,.55)"><span>Клиент один</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Застройщик</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Сеть клиник</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Отели Сочи</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Электротехника</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Юридическая группа</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Девелопер</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Интернет-магазин</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Клиент один</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Застройщик</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Сеть клиник</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Отели Сочи</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Электротехника</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Юридическая группа</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Девелопер</span><span style="width:5px;height:5px;background:#FA001E"></span><span>Интернет-магазин</span><span style="width:5px;height:5px;background:#FA001E"></span></div></div></div>
</div>
