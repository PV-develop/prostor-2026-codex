---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contacts from '../../components/home/Contacts.astro';
import Cases from '../../components/home/Cases.astro';
import ServiceHero from '../../components/blocks/ServiceHero.astro';
import ExpertContactForm from '../../components/blocks/ExpertContactForm.astro';
import AnalyticsShowcase from '../../components/blocks/AnalyticsShowcase.astro';
import Certificates from '../../components/blocks/Certificates.astro';
import BlogArticles from '../../components/blog/BlogArticles.astro';
import ServiceDecisionMatrix from '../../components/blocks/ServiceDecisionMatrix.astro';
import ProcessCards from '../../components/blocks/ProcessCards.astro';
import '../../styles/global.css';

const title = 'Performance-маркетинг под задачи бизнеса — Простор';
const description = 'Подбираем и объединяем рекламные инструменты, чтобы привлекать целевые обращения и управлять стоимостью привлечения. Связываем кампании с аналитикой.';
const formAnchor = '#contacts';
const tasks = [
  { title: 'Нужны целевые обращения', description: 'Определить, какие рекламные инструменты стоит проверить для вашего продукта и аудитории.' },
  { title: 'Реклама есть, результат не устраивает', description: 'Разобраться, где теряются бюджет и обращения: в настройках рекламных кампаний, предложении, посадочной странице или обработке заявок.' },
  { title: 'Нужно проверить новое направление', description: 'Тестируем продукт, офферы, географию или аудиторию по заранее согласованным критериям.' },
  { title: 'Нужно увеличить объём', description: 'Находим возможности для роста и оцениваем влияние на стоимость и качество привлечения.' },
];

const approach = [
  { title: 'Цель и экономика продукта', description: 'Определяем какой результат/kpi оцениваем и какую стоимость привлечения лида/клиента/заказа и т.д. рассматриваем как ориентир' },
  { title: 'Аудитория и путь до покупки', description: 'Формулируем и предлагаем точки контакта и рекламные инструменты, которые стоит проверить' },
  { title: 'Состояние сайта и аналитика', description: 'Оцениваем текущее техническое состояние сайта, проверяем корректность настройки аналитики и, при необходимости, сами исправляем текущие ошибки до запуска рекламы' },
  { title: 'Медиапланирование и бюджет', description: 'До старта готовим все расчёты, формируем план запусков, список гипотез и считаем экономику, чтобы попадать в бюджет рекламы' },
  { title: 'Результаты тестов', description: 'Постоянно анализируем результаты на всех шагах воронки и касаниях с аудиторией. Определяем рекламные кампании, которые будем: продолжать, пересматривать, останавливать или расширять' },
];
const budgetCriteria = [
  { label: 'Цель проекта', title: 'Цель и экономика продукта', description: 'Какой результат оцениваем и какую стоимость привлечения берём за ориентир.' },
  { label: 'Аудитория', title: 'Аудитория и путь до покупки', description: 'Какие точки контакта и инструменты стоит проверить.' },
  { label: 'Готовность', title: 'Сайт и обработка заявок', description: 'Что подготовить до запуска и улучшить параллельно.' },
  { label: 'Ресурсы', title: 'Бюджет и доступные данные', description: 'С какого набора гипотез начать без распыления ресурсов.' },
  { label: 'Обратная связь', title: 'Результаты тестов', description: 'Что продолжать, пересматривать, останавливать или расширять.' },
  { label: 'Решение на выходе', title: 'Приоритет каналов, план тестов и бюджет', featured: true },
];
const process = [
  { title: 'Диагностика', description: 'Разбираем текущую ситуацию, анализируем сайт, рекламу и её результаты, если запускалась, цели, доступные данные и ограничения.', duration: '1–2 недели', label: 'Вы получаете', detail: 'Карту ограничений и точек роста' },
  { title: 'Планирование и подготовка предложения', description: 'Согласовываем гипотезы, инструменты, бюджет и показатели.', duration: '1 неделя', label: 'Вы получаете', detail: 'План тестов и медиаплан' },
  { title: 'Подготовка и запуск', description: 'Готовим кампании, материалы, настраиваем аналитику.', duration: '2–4 недели', label: 'Вы получаете', detail: 'Запущенные кампании и настроенную аналитику' },
  { title: 'Оптимизация', description: 'Анализируем результаты и корректируем работу.', duration: 'Каждый месяц', label: 'Вы получаете', detail: 'Отчёт и обновлённый план' },
  { title: 'Решение о развитии', description: 'Оцениваем дальнейшие гипотезы и возможности расширения.', duration: 'Постоянно', label: 'Вы получаете', detail: 'Рост на проверенных каналах' },
];
// Alt process block («От диагностики…» full-screen scrub): the timeline needs
// short stage names and a phase kicker; images are placeholders until the
// real artwork arrives.
const stageMeta = [
  { short: 'Диагностика', phase: 'До запуска', image: '/src/chips/photo-1486406146926-c627a92ad1ab.jpg' },
  { short: 'План', phase: 'До запуска', image: '/src/chips/photo-1504307651254-35680f356dfd.jpg' },
  { short: 'Запуск', phase: 'Запуск', image: '/src/chips/photo-1560518883-ce09059eeffa.jpg' },
  { short: 'Оптимизация', phase: 'После запуска', image: '/src/chips/photo-1519494026892-80bbd2d6fd0d.jpg' },
  { short: 'Развитие', phase: 'Развитие', image: '/src/chips/photo-1441986300917-64674bd600d8.jpg' },
];
const stages = process.map((item, index) => ({ ...item, ...stageMeta[index] }));
const faq = [
  { q: 'Сколько нужно бюджета на старт?', a: 'Зависит от ниши, региона и конкуренции. На диагностике считаем минимальный бюджет, при котором тесты дадут статистику для решений, и показываем экономику до запуска.' },
  { q: 'Как быстро появятся первые обращения?', a: 'Первые обращения обычно приходят в первые две недели после запуска. Стабильный поток и оптимизация стоимости — результат первых двух-трёх месяцев работы.' },
  { q: 'Что нужно от нас для запуска?', a: 'Доступы к сайту и рекламным кабинетам, информация о продукте и текущих результатах. Дальше готовим план запуска и согласуем его с вами.' },
  { q: 'Как вы считаете результат?', a: 'До запуска фиксируем, что считаем обращением, целевым действием и продажей, и настраиваем аналитику так, чтобы отчёт сходился с вашими данными.' },
  { q: 'Можно ли начать с одного канала?', a: 'Да. Часто разумнее сначала проверить один-два канала, получить данные и только потом расширять набор инструментов.' },
  { q: 'Что будет, если реклама не даёт результата?', a: 'Останавливаем неэффективные кампании, разбираем причины на каждом шаге воронки и перераспределяем бюджет по результатам тестов.' },
];
const blogPosts = [
  { image: '/src/cases/case-1.webp', date: '12 ноября 2026', title: 'Как снизить стоимость обращения в Директе', description: 'Разбираем структуру кампаний, минус-слова и управление ставками, которые помогают платить меньше за каждый лид.', section: 'Performance' },
  { image: '/src/cases/case-2.webp', date: '29 октября 2026', title: 'Сквозная аналитика: связываем рекламу с продажами', description: 'Почему CPL без данных о продажах вводит в заблуждение, и с чего начать настройку аналитики.', section: 'Аналитика' },
  { image: '/src/cases/case-3.webp', date: '15 октября 2026', title: 'Авито как источник заявок для B2B', description: 'Как оформление профиля и Авито Ads приводят обращения без больших рекламных бюджетов.', section: 'Кейсы' },
];
const subservices = [
  { title: 'Контекстная реклама', description: 'Запускаем и развиваем рекламу в Яндекс Директе с согласованными целями и аналитикой', tags: 'Яндекс Директ · Поиск · РСЯ', href: '#channels' },
  { title: 'Таргетированная реклама', description: 'Настраиваем и ведём рекламу в соцсетях и мессенджерах: подбираем аудитории, тестируем объявления и отслеживаем обращения', tags: 'VK · Telegram · Соцсети', href: '#channels' },
  { title: 'Яндекс Промостраницы', description: 'Создаём и продвигаем статьи в Яндекс Промостраницах, чтобы знакомить аудиторию с продуктом и привлекать заинтересованных пользователей на сайт', tags: 'Контент · Промо', href: '#channels' },
  { title: 'Авито', description: 'Оформляем и продвигаем объявления на Авито и с помощью Авито Ads, тестируем подачу предложений и отслеживаем обращения', tags: 'Объявления · Авито Ads', href: '#channels' },
  { title: 'Геосервисы', description: 'Оформляем и продвигаем карточки компании в картах и геосервисах, чтобы клиентам было проще найти и выбрать вас', tags: 'Карты · Локальный спрос', href: '#channels' },
];
---
<BaseLayout {title} {description}>
  <main class="performance-page">
    <ServiceHero
      title="Performance-маркетинг"
      accentText="под задачи бизнеса"
      description="Подбираем и объединяем рекламные инструменты, чтобы привлекать целевые обращения, лиды и будущих клиентов, а также управлять стоимостью привлечения и результатами. Связываем кампании с аналитикой и результатами обработки заявок."
      additionalLabel="Используем собственную аналитику Prostor."
      primaryCTA={{ label: 'Обсудить привлечение клиентов', href: formAnchor }}
      secondaryCTA={{ label: 'Получить аудит рекламы', href: formAnchor }}
      visualPreset="performance"
    />
    <section class="pm-section pm-tasks" id="tasks" data-page-nav="Задачи" aria-labelledby="pm-tasks-title">
      <div class="pm-section__intro section-heading-pair">
        <h2 class="page-display-heading section-heading-pair__title" id="pm-tasks-title"><span>Когда</span> бизнесу <span>нужна</span> работа с <span lang="en">performance</span>-рекламой</h2>
        <p class="pm-section__lead section-heading-pair__subtitle">Четыре ситуации, в которых performance-реклама помогает найти точки роста.</p>
      </div>
      <div class="pm-tasks__split">
        <div class="pm-tasks__aside">
          <div class="pm-tasks__visual">
            <img src="/src/chips/performance-team.jpg" alt="Специалисты агентства Простор" loading="lazy" />
            <div class="pm-tasks__plate"><span>Получить консультацию по моей задаче</span><a class="pm-tasks__cta" href="#expert">Обсудить рост <span>→</span></a></div>
          </div>
        </div>
        <div class="pm-task-list">{tasks.map((item) => <article class="pm-task-row"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      </div>
    </section>

    <ExpertContactForm />

    <section class="pm-toolkit" id="channels" data-page-nav="Каналы" aria-labelledby="pm-channels-title">
      <div class="pm-toolkit__heading-wrap"><div class="pm-section__title-row pm-toolkit__title-row section-heading-pair"><h2 class="page-display-heading section-heading-pair__title" id="pm-channels-title">Подбираем <span>инструменты</span> под вашу задачу</h2><p class="pm-section__lead pm-toolkit__lead section-heading-pair__subtitle">Пять инструментов — единая система привлечения, настроенная под продукт и аудиторию.</p></div></div>
      <div style="margin-top:var(--section-content-gap);border-top:1px solid #C2C5CA">
        {subservices.map((item, index) => <a href={item.href} data-reveal data-m="srow" style="display:grid;align-items:center;padding:36px var(--gutter);background-image:linear-gradient(0deg,#0F0F0F 50%,transparent 50%);background-size:100% 201%;background-position:0 0;background-repeat:no-repeat;transition:background-position .6s cubic-bezier(.7,0,.2,1),color .4s" class={`export-hover-${40 + index}`}><span class="service-title service-title--row">{item.title}</span><span style="font:var(--type-body);opacity:.8;max-width:420px;text-wrap:pretty">{item.description}<br /><span style="font:var(--type-label);letter-spacing:0;display:block;margin-top:14px;opacity:.65">{item.tags}</span></span><span style="width:56px;height:56px;border:1px solid currentColor;display:flex;align-items:center;justify-content:center;font:var(--type-icon)">→</span></a>)}
        <a class="pm-toolkit__featured export-hover-45" href="#expert" data-reveal data-m="srow" aria-label="Обсудить комплексный маркетинг">
          <span class="pm-toolkit__featured-title"><span class="pm-toolkit__featured-badge">Всё вместе</span><span class="pm-toolkit__featured-name service-title service-title--row"><span>Комплексный</span> маркетинг</span></span>
          <span class="pm-toolkit__featured-copy">Локальная видимость и звонки из карт и геосервисов<span>Карты · Локальный спрос</span></span>
          <span class="pm-toolkit__featured-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <Cases />

    <section class="pm-section pm-approach" id="approach" data-page-nav="Подход" aria-labelledby="pm-approach-title">
      <div class="pm-section__title-row section-heading-pair"><h2 class="page-display-heading section-heading-pair__title" id="pm-approach-title">Как мы <span>определяем</span>, куда направить <span>бюджет</span></h2><p class="pm-approach__summary section-heading-pair__subtitle">Не распределяем бюджет поровну между площадками. Сначала определяем приоритеты и критерии проверки, затем корректируем план по результатам.</p></div>
      <ServiceDecisionMatrix items={approach} />
      <div class="pm-budget-v2" aria-label="Куда направляем бюджет">
        <h2 class="pm-budget-v2__title">Куда направляем <span>бюджет</span></h2>
        <div class="pm-budget-v2__principle">
          <div><span class="pm-budget-v2__eyebrow">Правило распределения</span><h4>Не распределяем бюджет поровну между площадками.</h4></div>
          <p>Сначала определяем приоритеты и критерии проверки, затем корректируем план по результатам.</p>
        </div>
        <div class="pm-budget-v2__grid">
          {budgetCriteria.map((item) => <article class:list={["pm-budget-v2__card", item.featured && "pm-budget-v2__card--featured"]}>
            <span class="pm-budget-v2__eyebrow">{item.label}</span>
            <h4>{item.title}</h4>
            {item.description && <p>{item.description}</p>}
          </article>)}
        </div>
      </div>
    </section>

    <section class="pm-metrics" id="metrics" data-page-nav="Метрики" aria-labelledby="pm-metrics-title">
      <div class="pm-section__title-row section-heading-pair"><h2 class="page-display-heading section-heading-pair__title" id="pm-metrics-title">Согласовываем показатели<br />до запуска</h2><p class="section-heading-pair__subtitle" style="color:rgba(233,235,239,.72)">Для каждого проекта выбираем применимые показатели и фиксируем, что именно считаем лидом, целевым обращением и продажей. При необходимости настраиваем аналитику: от базовых целей в Метрике до полноценной сквозной аналитики.</p></div>
      <div class="pm-metric-grid"><article><span>01</span><h3>Обращения</h3><p>Количество лидов, CPL — стоимость обращения, CPO — стоимость заказа.</p></article><article><span>02</span><h3>Качество</h3><p>Количество и стоимость квалифицированных обращений по согласованным критериям.</p></article><article><span>03</span><h3>Целевые действия</h3><p>CPA — стоимость конкретного согласованного действия, CR — конверсия на выбранном этапе.</p></article><article><span>04</span><h3>Продажи и экономика</h3><p>Выручка, стоимость привлечения покупателя, ROMI, ДРР.</p></article></div>
    </section>

    <AnalyticsShowcase />

    <section class="pm-section pm-process" id="process" data-page-nav="Процесс" aria-labelledby="pm-process-title">
      <div class="pm-section__title-row section-heading-pair"><h2 class="page-display-heading section-heading-pair__title" id="pm-process-title">От диагностики до регулярной оптимизации</h2><p class="pm-section__lead section-heading-pair__subtitle">Последовательность этапов и ясные решения на каждом шаге работы.</p></div>
      <ProcessCards items={process} inset={false} />
    </section>

    <section class="pm-stage" id="stages" aria-labelledby="pm-stage-title" style={`--stage-n:${stages.length}`}>
      <div class="pm-stage__pin">
        <div class="pm-stage__frame">
          <header class="pm-stage__head section-heading-pair">
            <h2 class="section-heading-pair__title" id="pm-stage-title">От диагностики <span>до оптимизации</span></h2>
            <p class="pm-stage__lead section-heading-pair__subtitle">Разбираем исходную ситуацию, согласуем план и запускаем кампании.</p>
          </header>
          <div class="pm-stage__timeline">
            {stages.map((stage) => <div class="pm-stage__point"><span class="pm-stage__mark" aria-hidden="true"></span><span class="pm-stage__name">{stage.short}</span><span class="pm-stage__dur">{stage.duration}</span></div>)}
          </div>
          <div class="pm-stage__body">
            {stages.map((stage) => <article class="pm-stage__slide">
              <div class="pm-stage__info">
                <p class="pm-stage__kicker">{stage.phase} / {stage.duration}</p>
                <h3>{stage.title}</h3>
                <p class="pm-stage__desc">{stage.description}</p>
                <p class="pm-stage__gain">{stage.label}</p>
                <p class="pm-stage__result">{stage.detail}</p>
              </div>
              <div class="pm-stage__visual"><img src={stage.image} alt="" loading="lazy" /></div>
            </article>)}
          </div>
        </div>
      </div>
    </section>

    <section class="pm-section pm-pricing" id="pricing" data-page-nav="Стоимость" aria-labelledby="pm-pricing-title">
      <div class="pm-section__title-row section-heading-pair"><h2 class="page-display-heading section-heading-pair__title" id="pm-pricing-title">Из чего складывается стоимость</h2><p class="pm-section__lead section-heading-pair__subtitle">В предложении отдельно показываем работу агентства и расходы на размещение.</p></div>
      <div class="pm-pricing__grid">
        <div class="pm-pricing__main">
          <article class="pm-pricing__card">
            <p class="pm-pricing__label">Услуги агентства</p>
            <h3>Работа агентства</h3>
            <p>Подготовка, запуск, ведение, аналитика и другие согласованные работы.</p>
          </article>
          <article class="pm-pricing__card">
            <p class="pm-pricing__label">Бюджет площадок</p>
            <h3>Рекламный бюджет</h3>
            <p>Расходы на размещение на выбранных площадках.</p>
          </article>
        </div>
        <aside class="pm-pricing__extra">
          <p class="pm-pricing__label">По согласованию</p>
          <h3>Отдельные задачи</h3>
          <p class="pm-pricing__extra-text">Если проекту нужны дополнительные материалы или связки, включаем их в предложение отдельными строками.</p>
          <a class="pm-pricing__extra-cta" href="#contacts">Обсудить сотрудничество <span>→</span></a>
        </aside>
      </div>
    </section>

    <section class="pm-section pm-faq" id="faq" data-page-nav="FAQ" aria-labelledby="pm-faq-title">
      <div class="pm-faq__split">
        <div class="pm-faq__intro">
          <h2 class="page-display-heading" id="pm-faq-title">Частые вопросы</h2>
          <p class="pm-section__lead">Не нашли ответ на свой вопрос? Задайте его — разберём вашу ситуацию и подскажем, что сработает.</p>
          <a class="pm-faq__ask" href="#contacts">Задать вопрос <span>→</span></a>
        </div>
        <div class="pm-faq__list">
          {faq.map((item) => <details class="pm-faq__item">
            <summary class="pm-faq__q"><span>{item.q}</span><span class="pm-faq__icon" aria-hidden="true"><svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" style="width:18px;height:18px;display:block"><path d="M9 2v14M2 9h14"></path></svg></span></summary>
