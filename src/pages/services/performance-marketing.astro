---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contacts from '../../components/home/Contacts.astro';
import Cases from '../../components/home/Cases.astro';
import ServiceHero from '../../components/blocks/ServiceHero.astro';
import BlogArticles from '../../components/blog/BlogArticles.astro';
import ServiceDecisionMatrix from '../../components/blocks/ServiceDecisionMatrix.astro';
import ProcessCards from '../../components/blocks/ProcessCards.astro';
import '../../styles/global.css';

const title = 'Performance-маркетинг под задачи бизнеса — Простор';
const description = 'Подбираем и объединяем рекламные инструменты, чтобы привлекать целевые обращения и управлять стоимостью привлечения. Связываем кампании с аналитикой.';
const formAnchor = '#contacts';
const navigationItems = [
  { label: 'Задачи', href: '#tasks' }, { label: 'Каналы', href: '#channels' },
  { label: 'Подход', href: '#approach' }, { label: 'Метрики', href: '#metrics' },
  { label: 'Процесс', href: '#process' }, { label: 'Стоимость', href: '#pricing' },
  { label: 'Кейсы', href: '#cases' }, { label: 'Блог', href: '#blog' },
] as const;
const tasks = [
  { title: 'Нужны целевые обращения', description: 'Определить, какие рекламные инструменты стоит проверить для вашего продукта и аудитории.' },
  { title: 'Реклама есть, результат не устраивает', description: 'Разобраться, где теряются бюджет и обращения: в настройках рекламных кампаний, предложении, посадочной странице или обработке заявок.' },
  { title: 'Нужно проверить новое направление', description: 'Протестировать продукт, оффер, географию или аудиторию по заранее согласованным критериям.' },
  { title: 'Нужно увеличить объём', description: 'Найти возможности роста и оценить, как расширение повлияет на стоимость и качество привлечения.' },
];

const approach = [
  { title: 'Цель и экономика продукта', description: 'Какой результат/KPI оцениваем и какую стоимость привлечения рассматриваем как ориентир.' },
  { title: 'Аудитория и путь до покупки', description: 'Какие точки контакта и рекламные инструменты стоит проверить.' },
  { title: 'Состояние сайта и обработки заявок', description: 'Что нужно подготовить до запуска или улучшить параллельно.' },
  { title: 'Доступный бюджет и данные', description: 'С какого набора гипотез начать, чтобы не распылять ресурсы.' },
  { title: 'Результаты тестов', description: 'Что продолжать, пересматривать, останавливать или расширять.' },
];
const process = [
  { title: 'Диагностика', description: 'Разбираем текущую ситуацию, анализируем сайт, рекламу и её результаты, если запускалась, цели, доступные данные и ограничения.', duration: '1–2 недели', label: 'Вы получаете', detail: 'Карту ограничений и точек роста' },
  { title: 'Планирование и подготовка предложения', description: 'Согласовываем гипотезы, инструменты, бюджет и показатели.', duration: '1 неделя', label: 'Вы получаете', detail: 'План тестов и медиаплан' },
  { title: 'Подготовка и запуск', description: 'Готовим кампании, материалы, настраиваем аналитику.', duration: '2–4 недели', label: 'Вы получаете', detail: 'Запущенные кампании и настроенную аналитику' },
  { title: 'Оптимизация', description: 'Анализируем результаты и корректируем работу.', duration: 'Каждый месяц', label: 'Вы получаете', detail: 'Отчёт и обновлённый план' },
  { title: 'Решение о развитии', description: 'Оцениваем дальнейшие гипотезы и возможности расширения.', duration: 'Постоянно', label: 'Вы получаете', detail: 'Рост на проверенных каналах' },
];
const additionalCosts = ['Посадочные страницы', 'Интеграции', 'Производство рекламных материалов', 'Коллтрекинг', 'Другие согласованные доработки'];
const blogPosts = [
  { image: '/src/cases/case-1.webp', date: '12 ноября 2026', title: 'Как снизить стоимость обращения в Директе', description: 'Разбираем структуру кампаний, минус-слова и управление ставками, которые помогают платить меньше за каждый лид.', section: 'Performance' },
  { image: '/src/cases/case-2.webp', date: '29 октября 2026', title: 'Сквозная аналитика: связываем рекламу с продажами', description: 'Почему CPL без данных о продажах вводит в заблуждение, и с чего начать настройку аналитики.', section: 'Аналитика' },
  { image: '/src/cases/case-3.webp', date: '15 октября 2026', title: 'Авито как источник заявок для B2B', description: 'Как оформление профиля и Авито Ads приводят обращения без больших рекламных бюджетов.', section: 'Кейсы' },
];
const subservices = [
  { title: 'Контекстная реклама', description: 'Привлекать обращения из поиска и сетей Яндекса там, где спрос уже сформирован', tags: 'Яндекс Директ · Поиск · РСЯ', href: '#channels' },
  { title: 'Таргетированная реклама', description: 'Находить и прогревать целевые аудитории в соцсетях и мессенджерах', tags: 'VK · Telegram · Соцсети', href: '#channels' },
  { title: 'Яндекс Промостраницы', description: 'Знакомить аудиторию с продуктом через полезные статьи и приводить заинтересованных', tags: 'Контент · Промо', href: '#channels' },
  { title: 'Авито', description: 'Быстрые обращения и продажи через объявления и Авито Ads', tags: 'Объявления · Авито Ads', href: '#channels' },
  { title: 'Геосервисы', description: 'Локальная видимость и звонки из карт и геосервисов', tags: 'Карты · Локальный спрос', href: '#channels' },
];
---
<BaseLayout {title} {description}>
  <main class="performance-page">
    <ServiceHero
      eyebrow="Performance · Prostor"
      title="Performance-маркетинг"
      accentText="под задачи бизнеса."
      description="Подбираем и объединяем рекламные инструменты, чтобы привлекать целевые обращения, лиды и будущих клиентов, а также управлять стоимостью привлечения и результатами. Связываем кампании с аналитикой и результатами обработки заявок."
      additionalLabel="Используем собственную аналитику Prostor."
      primaryCTA={{ label: 'Обсудить привлечение клиентов', href: formAnchor }}
      secondaryCTA={{ label: 'Получить аудит рекламы', href: formAnchor }}
      visualPreset="performance"
      navigationItems={navigationItems}
    />
    <section class="pm-section pm-tasks" id="tasks" aria-labelledby="pm-tasks-title">
      <div class="pm-section__intro">
        <p class="pm-eyebrow" data-tl="h"><i></i>01 / Задачи</p>
        <h2 class="page-display-heading" id="pm-tasks-title"><span>Когда</span> бизнесу <span>нужна</span> работа с <span lang="en">performance</span>-рекламой</h2>
        <p class="pm-section__lead">Четыре ситуации, в которых performance-реклама помогает найти точки роста.</p>
      </div>
      <div class="pm-task-list">{tasks.map((item, index) => <article class="pm-task-row"><span class="pm-task-row__number">{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.description}</p></div><span class="pm-task-row__arrow" aria-hidden="true">↗</span></article>)}</div>
    </section>

    <section class="pm-toolkit" id="channels" aria-labelledby="pm-channels-title" style="padding:90px 0 0">
      <div style="padding:0 var(--gutter)"><div class="pm-section__title-row pm-toolkit__title-row"><p class="pm-eyebrow" data-tl="v">02 / Каналы<span style="width:7px;height:7px;background:#FA001E;display:inline-block;flex:none"></span></p><h2 class="page-display-heading" id="pm-channels-title">Подбираем <span>инструменты</span> под вашу задачу</h2><h3 class="pm-section__lead pm-toolkit__lead">Пять инструментов — единая система привлечения, настроенная под продукт и аудиторию.</h3></div></div>
      <div style="margin-top:72px;border-top:1px solid #0F0F0F">
        {subservices.map((item, index) => <a href={item.href} data-reveal data-m="srow" style="display:grid;grid-template-columns:minmax(72px,168px) minmax(0,3fr) minmax(0,2fr) 56px;column-gap:24px;align-items:center;padding:36px var(--gutter);border-bottom:1px solid #0F0F0F;background-image:linear-gradient(90deg,#0F0F0F 50%,transparent 50%);background-size:201% 100%;background-position:100% 0;background-repeat:no-repeat;transition:background-position .6s cubic-bezier(.7,0,.2,1),color .4s" class={`export-hover-${40 + index}`}><span data-tl="" style="display:flex;align-items:center;gap:10px;font:500 13px/1.35 Onest,sans-serif;letter-spacing:0;align-self:start;margin:10px 0 0 12px;justify-self:start;clip-path:inset(0 100% 0 0);transition:clip-path .5s cubic-bezier(.7,0,.2,1)"><span style="width:8px;height:8px;background:#FA001E;flex:none"></span><span style="opacity:.5">{String(index + 1).padStart(2, '0')}</span></span><span style="font:700 clamp(40px,5vw,72px)/.92 Steelfish,sans-serif;font-stretch:25%;text-transform:uppercase;letter-spacing:-.005em">{item.title}</span><span style="font-size:15px;line-height:1.5;opacity:.8;max-width:420px;text-wrap:pretty">{item.description}<br /><span style="font:500 13px/1.35 Onest,sans-serif;letter-spacing:0;display:block;margin-top:14px;opacity:.65">{item.tags}</span></span><span style="width:56px;height:56px;border:1px solid currentColor;display:flex;align-items:center;justify-content:center;font:500 16px 'JetBrains Mono',monospace">→</span></a>)}
      </div>
    </section>

    <section class="pm-section pm-approach" id="approach" aria-labelledby="pm-approach-title">
      <div class="pm-section__title-row"><p class="pm-eyebrow" data-tl="v">03 / Подход<span style="width:7px;height:7px;background:#FA001E;display:inline-block;flex:none"></span></p><h2 class="page-display-heading" id="pm-approach-title">Как мы <span>определяем</span>, куда направить <span>бюджет</span></h2><aside class="service-decision-matrix__feature"><h3>Не распределяем бюджет поровну между площадками</h3><p>Сначала определяем приоритеты и критерии проверки, затем корректируем план по результатам.</p></aside></div>
      <ServiceDecisionMatrix items={approach} />
    </section>

    <section class="pm-metrics" id="metrics" aria-labelledby="pm-metrics-title">
      <div class="pm-section__title-row"><p class="pm-eyebrow" data-tl="h"><i></i>04 / Аналитика</p><h2 class="page-display-heading" id="pm-metrics-title">Согласовываем показатели<br />до запуска</h2></div>
      <div class="pm-metric-grid"><article><span>01</span><h3>Обращения</h3><p>Количество лидов, CPL — стоимость обращения, CPO — стоимость заказа.</p></article><article><span>02</span><h3>Качество</h3><p>Количество и стоимость квалифицированных обращений по согласованным критериям.</p></article><article><span>03</span><h3>Целевые действия</h3><p>CPA — стоимость конкретного согласованного действия, CR — конверсия на выбранном этапе.</p></article><article><span>04</span><h3>Продажи и экономика</h3><p>Выручка, стоимость привлечения покупателя, ROMI, ДРР.</p></article></div>
      <p class="pm-metrics__foot">Для каждого проекта выбираем применимые показатели и фиксируем, что именно считаем лидом, целевым обращением и продажей. При необходимости настраиваем аналитику: от базовых целей в Метрике до полноценной сквозной аналитики.</p>
    </section>

    <section class="pm-section pm-process" id="process" aria-labelledby="pm-process-title">
      <div class="pm-section__title-row"><p class="pm-eyebrow" data-tl="h"><i></i>05 / Процесс</p><h2 class="page-display-heading" id="pm-process-title">От диагностики до регулярной оптимизации</h2><p class="pm-section__lead">Последовательность этапов и ясные решения на каждом шаге работы.</p></div>
      <ProcessCards items={process} inset={false} />
    </section>

    <section class="pm-section pm-pricing" id="pricing" aria-labelledby="pm-pricing-title">
      <div class="pm-section__title-row"><p class="pm-eyebrow" data-tl="h"><i></i>06 / Стоимость</p><h2 class="page-display-heading" id="pm-pricing-title">Сколько стоит performance-маркетинг</h2></div>
      <div class="pm-price-grid"><article><span class="pm-price-card__index">01</span><div><p class="pm-price-card__label">Услуги агентства</p><h3>Работа агентства</h3><p>Подготовка, запуск, ведение, аналитика и другие согласованные работы.</p></div></article><article><span class="pm-price-card__index">02</span><div><p class="pm-price-card__label">Бюджет площадок</p><h3>Рекламный бюджет</h3><p>Расходы на размещение на выбранных площадках.</p></div></article></div>
      <div class="pm-additional-costs"><h3>Также могут потребоваться отдельно</h3><ul>{additionalCosts.map((item) => <li>{item}</li>)}</ul></div>
    </section>
    
    <Cases label="07 / Кейсы" />
    <section class="pm-blog" id="blog" aria-labelledby="pm-blog-title" style="padding:140px 0 160px">
      <div style="padding:0 var(--gutter)">
        <p class="pm-eyebrow" data-tl="h"><i></i>08 / Блог</p>
        <BlogArticles heading="Статьи, которые помогают расти" posts={blogPosts} allHref="#" />
      </div>
    </section>
    <Contacts />
  </main>
</BaseLayout>
<script>
  import '../../scripts/home';

  // Metrics sweep: a horizontal red line grows out of the vertical thread at
  // x=22 and runs through the column numbers at their vertical centre,
  // keeping a 5px clearance on both sides of every digit, and continues to
  // the screen edge. Each number pops in as the line reaches it; scrolling
  // back plays the whole thing in reverse (far end retracts first). Rows
  // sweep one after another on narrow layouts where the grid wraps.
  (() => {
    const grid = document.querySelector<HTMLElement>('.pm-metric-grid');
    if (!grid) return;
    const nums = [...grid.querySelectorAll<HTMLElement>('article > span')];
    const SPEED = 0.8, GAP = 5, NDUR = 400; // px per ms, digit clearance, number fade
    let shown = false;
    const apply = (on: boolean) => {
      grid.querySelectorAll('i[data-seg]').forEach((e) => e.remove());
      const gr = grid.getBoundingClientRect();
      const x0 = Math.max(22, (innerWidth - 1600) / 2 - 26) - gr.left, endX = window.innerWidth - gr.left;
      // offset* measurements ignore the reveal translate, so the line sits at
      // the digits' true resting centre.
      const items = nums.map((n) => ({ el: n, l: n.offsetLeft, r: n.offsetLeft + n.offsetWidth, y: n.offsetTop + n.offsetHeight / 2, top: n.offsetTop }));
      const rows: { y: number; idx: number[] }[] = [];
      items.forEach((it, i) => {
        const row = rows[rows.length - 1];
        if (row && Math.abs(items[row.idx[0]].top - it.top) < 8) row.idx.push(i);
        else rows.push({ y: it.y, idx: [i] });
      });
      const segs: { l: number; w: number; y: number; d: number }[] = [];
      const numDelays: number[] = [];
      let clock = 0;
      rows.forEach((row, ri) => {
        const first = items[row.idx[0]], last = items[row.idx[row.idx.length - 1]];
        segs.push({ l: x0, w: first.l - GAP - x0, y: row.y, d: clock });
        row.idx.forEach((i) => { numDelays[i] = clock + (items[i].l - x0) / SPEED + 80; });
        for (let k = 0; k + 1 < row.idx.length; k++) {
          const a = items[row.idx[k]], b = items[row.idx[k + 1]];
          const l = a.r + GAP;
          segs.push({ l, w: b.l - GAP - l, y: row.y, d: clock + (l - x0) / SPEED });
        }
        if (ri === rows.length - 1) segs.push({ l: last.r + GAP, w: Math.max(0, endX - last.r - GAP), y: row.y, d: clock + (last.r + GAP - x0) / SPEED });
        clock += (last.r - x0) / SPEED + 250;
      });
      const total = clock;
      const els: HTMLElement[] = [];
      segs.forEach((s) => {
        if (s.w <= 0) return;
        const dur = Math.max(120, s.w / SPEED);
        const d = document.createElement('i');
        d.dataset.seg = '1';
        d.style.left = `${s.l.toFixed(1)}px`;
        d.style.top = `${s.y.toFixed(1)}px`;
        d.style.width = `${s.w.toFixed(1)}px`;
        d.style.transform = on ? 'scaleX(0)' : 'scaleX(1)';
        // the reverse timeline mirrors the forward one around the total
        const delay = on ? s.d : Math.max(0, total - s.d - dur);
        d.style.transition = `transform ${dur.toFixed(0)}ms linear ${delay.toFixed(0)}ms`;
        grid.appendChild(d);
        els.push(d);
      });
      nums.forEach((n, i) => {
        const fwd = numDelays[i];
        n.style.transitionDelay = `${(on ? fwd : Math.max(0, total - fwd - NDUR)).toFixed(0)}ms`;
      });
      // Flip on the next frame; the timeout covers paused-animation webviews.
      const flip = () => {
        grid.dataset.line = on ? '1' : '0';
        els.forEach((e) => { e.style.transform = on ? 'scaleX(1)' : 'scaleX(0)'; });
      };
      let done = false;
      requestAnimationFrame(() => { if (!done) { done = true; flip(); } });
      setTimeout(() => { if (!done) { done = true; flip(); } }, 48);
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      grid.dataset.line = '1';
      return;
    }
    grid.dataset.line = '0';
    // Scroll-driven both ways: extend once the block is well in view, retract
    // (mirrored) when it leaves in either direction. IntersectionObserver
    // callbacks ride the rendering pipeline, which stays paused in some
    // webviews; plain scroll events do not always fire for programmatic
    // scrolls there either, so a light poll backs them up.
    const check = () => {
      const r = grid.getBoundingClientRect();
      const extend = !shown && r.top < innerHeight * 0.65 && r.bottom > innerHeight * 0.1;
      const retract = shown && (r.bottom < innerHeight * 0.3 || r.top > innerHeight * 0.9);
      if (extend || retract) { shown = extend; apply(shown); }
    };
    addEventListener('scroll', check, { passive: true });
    window.setInterval(check, 400);
    check();
  })();
</script>
<style>
.performance-page{background:#E9EBEF;color:#0F0F0F;overflow:clip}.pm-section{padding:108px var(--gutter)}.pm-section__title-row{display:grid;grid-template-columns:minmax(120px,.45fr) minmax(0,1.55fr) minmax(200px,.8fr);gap:26px;align-items:start;margin-bottom:48px}.pm-eyebrow{display:flex;align-items:center;gap:10px;color:#BD0000;font:500 11px 'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.07em;margin:7px 0}.pm-eyebrow i{width:7px;height:7px;background:#FA001E;display:inline-block;flex:none}.pm-section h2,.pm-metrics h2{font:700 clamp(44px,5.7vw,82px)/.92 Steelfish,sans-serif;text-transform:uppercase;letter-spacing:-.008em;margin:0;text-wrap:balance}.pm-section__lead{font-size:15px;line-height:1.5;color:rgba(15,15,15,.7);margin:6px 0 0;max-width:340px;text-wrap:pretty}.pm-tasks{display:grid;grid-template-columns:minmax(0,35fr) minmax(0,65fr);gap:6vw;align-items:start}.pm-section__intro .pm-eyebrow{margin:8px 0 25px}.pm-section__intro h2{font-size:clamp(44px,5.2vw,72px)}.pm-section__intro .pm-section__lead{margin-top:26px;max-width:360px}.pm-task-list{border-top:1px solid rgba(15,15,15,.28)}.pm-task-row{display:grid;grid-template-columns:44px minmax(0,1fr) 32px;gap:16px;align-items:start;padding:23px 4px 24px 0;border-bottom:1px solid rgba(15,15,15,.22)}.pm-task-row>span:first-child{font:500 10px 'JetBrains Mono',monospace;color:#FA001E;padding-top:3px}.pm-task-row h3{font:700 clamp(25px,2.8vw,37px)/.95 Steelfish,sans-serif;text-transform:uppercase;margin:0 0 10px}.pm-task-row p{margin:0;font-size:14px;line-height:1.5;color:rgba(15,15,15,.72);max-width:620px}.pm-task-row__arrow{font:20px 'JetBrains Mono',monospace;color:#FA001E;justify-self:end}.pm-toolkit{padding-top:90px}.pm-toolkit .pm-section__title-row{grid-template-columns:minmax(120px,.45fr) minmax(0,1.55fr) minmax(200px,.8fr)}.pm-approach{background:#DDE0E5;padding-top:108px}.pm-approach .pm-section__title-row{grid-template-columns:minmax(120px,.45fr) minmax(0,2.35fr)}.pm-approach__note{margin:26px 0 0 auto;max-width:700px;background:#0F0F0F;color:#E9EBEF;padding:24px 30px 24px 34px;border-left:3px solid #FA001E;font-size:15px;line-height:1.55}.pm-metrics{padding:105px var(--gutter);background:#0F0F0F;color:#E9EBEF}.pm-metrics .pm-section__title-row{grid-template-columns:minmax(120px,.45fr) minmax(0,2.35fr)}.pm-metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));position:relative}
.pm-metric-grid:before,.pm-metric-grid:after{content:"";position:absolute;left:50%;transform:translateX(-50%);width:100vw;height:1px;background:rgba(233,235,239,.2)}
.pm-metric-grid:before{top:0}.pm-metric-grid:after{bottom:0}
.pm-metric-grid article>span{display:inline-block;transition:opacity .4s ease,transform .4s ease}
