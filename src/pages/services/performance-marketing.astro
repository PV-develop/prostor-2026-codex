  })();

  // Task index numbers flip to the brand red once their centre passes above
  // the middle of the screen (and back to ink on the way down). The light
  // poll mirrors the sweep watcher above for throttled webviews.
  (() => {
    const nums = [...document.querySelectorAll<HTMLElement>('.pm-task-row__index')];
    if (!nums.length) return;
    const check = () => {
      const mid = innerHeight / 2;
      nums.forEach((n) => {
