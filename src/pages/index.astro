---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Cases from '../components/home/Cases.astro';
import Process from '../components/home/Process.astro';
import TeamReviews from '../components/home/TeamReviews.astro';
import Contacts from '../components/home/Contacts.astro';
import '../styles/global.css';

const title = 'Простор — digital-агентство полного цикла';
const description = 'Стратегия и digital-маркетинг для роста бизнеса: продвижение, аналитика и разработка.';
---
<BaseLayout {title} {description}>
  <div class="home-shell" style="margin: 0 auto; background: #E9EBEF; overflow: clip">
    <Hero />
    <Services />
    <Cases />
    <Process />
    <TeamReviews />
    <Contacts />
  </div>
</BaseLayout>
<script>
  import '../scripts/home';
</script>
