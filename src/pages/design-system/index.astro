---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLibrary } from '../../data/design-system';
import '../../styles/global.css';

const library = await getLibrary();
const colors = [
  ['ink', 'Текст'], ['paper', 'Фон'], ['red', 'Акцент'], ['red-deep', 'Тёмный акцент'],
  ['surface', 'Поверхность'], ['card', 'Карточка'],
];
const exampleUrl = (slug: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/design-system/${slug}/`;
---
<BaseLayout title="Дизайн-система — Простор" description="Элементы оформления и библиотека блоков сайта Простор." noindex>
  <main class="library">
    <header class="intro">
      <a href={import.meta.env.BASE_URL} aria-label="Простор — на главную"><img src="/src/logo-black.svg" alt="Простор" width="148" /></a>
      <h1>Дизайн-система</h1>
    </header>
    <details class="foundations">
      <summary>Основы оформления</summary>
      <div class="palette">
        {colors.map(([token, label]) => <div><i style={`background:var(--color-${token})`}></i>{label}<code>--color-{token}</code></div>)}
      </div>
      <div class="type">
        <div><b>Steelfish</b><span>Заголовки</span></div>
        <div><strong>Onest</strong><span>Основной текст</span></div>
        <div><code>JetBrains Mono</code><span>Подписи и кнопки</span></div>
      </div>
      <p>Боковое поле задаёт <code>--gutter</code>, отступы секции — <code>--section-space-y</code>, расстояние от заголовка до содержимого — <code>--section-content-gap</code>.</p>
    </details>
    <div class="workspace">
      <nav aria-label="Библиотека блоков">
        <h2>Блоки</h2>
        {library.map(entry => <a href={exampleUrl(entry.examples[0].slug)} data-entry={entry.id}>{entry.title}</a>)}
      </nav>
      <section class="viewer" aria-label="Просмотр блока">
        {library.map((entry, index) => <div data-panel={entry.id} hidden={index !== 0}>
          <h2>{entry.title}</h2>
          <p>{entry.description}</p>
          {entry.examples.length > 1 && <div class="variants" aria-label="Варианты">{entry.examples.map(ex =>
            <a data-variant={ex.slug} href={exampleUrl(ex.slug)}>{ex.label}</a>)}</div>}
          {entry.examples.map((ex, i) => <div data-snippet={ex.slug} hidden={i !== 0}>
            <pre><code>{ex.code}</code></pre>
            <a class="open" href={exampleUrl(ex.slug)} target="_blank" rel="noopener">Открыть пример отдельно ↗</a>
          </div>)}
        </div>)}
        <iframe title={library[0].title} src={exampleUrl(library[0].examples[0].slug)}></iframe>
      </section>
    </div>
  </main>
</BaseLayout>
<script>
  const nav = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-entry]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const frame = document.querySelector('iframe')!;
  const viewer = document.querySelector<HTMLElement>('.viewer')!;

  function select() {
    const slug = location.hash.slice(1);
    const snippets = Array.from(document.querySelectorAll<HTMLElement>('[data-snippet]'));
    const current = snippets.find(el => el.dataset.snippet === slug) ?? snippets[0];
    const active = current.closest<HTMLElement>('[data-panel]')!;
    for (const panel of panels) panel.hidden = panel !== active;
    for (const snippet of snippets) snippet.hidden = snippet !== current;
    for (const link of nav) link.setAttribute('aria-current', String(link.dataset.entry === active.dataset.panel));
    for (const link of active.querySelectorAll<HTMLElement>('[data-variant]')) {
      link.setAttribute('aria-current', String(link.dataset.variant === current.dataset.snippet));
    }
    const url = current.querySelector('a')!.href;
    if (frame.src !== url) frame.src = url;
    frame.title = active.querySelector('h2')!.textContent!;
    if (slug && matchMedia('(max-width: 760px)').matches) viewer.scrollIntoView();
  }
  document.querySelector('.library')!.addEventListener('click', event => {
    if (!(event instanceof MouseEvent) || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const link = event.target instanceof Element && event.target.closest<HTMLAnchorElement>('[data-entry], [data-variant]');
    if (!link) return;
    event.preventDefault();
    const slug = link.pathname.split('/').filter(Boolean).pop()!;
    if (location.hash === '#' + slug) select();
    else location.hash = slug;
  });
  window.addEventListener('hashchange', select);
  select();
</script>
<style>
  .library { padding:32px var(--gutter) var(--section-space-y); color:var(--color-ink); background:var(--color-paper); min-height:100vh }
  .intro { border-bottom:2px solid var(--color-ink); padding-bottom:var(--space-6) }
  .intro img { display:block; height:auto }
  .intro h1 { font:var(--type-h1); margin:var(--space-10) 0 0; text-transform:uppercase }
  .foundations { border-bottom:1px solid var(--color-ink); padding:20px 0 }
  summary { cursor:pointer; font:var(--type-ui-emphasis) }
  .palette,.type { display:grid; gap:16px; margin:24px 0; grid-template-columns:repeat(auto-fit,minmax(min(140px,100%),1fr)) }
  .palette i { display:block; height:48px; border:1px solid #0002; margin-bottom:8px }
  .palette code,.type span { display:block; margin-top:6px; font:var(--type-meta) }
  .type b { font:var(--type-h3) }
  .type strong,.type div>code { font-size:24px }
  .workspace { display:grid; grid-template-columns:minmax(190px,1fr) minmax(0,4fr); gap:var(--space-8); padding-top:var(--space-8) }
  nav { align-self:start }
  h2 { font:var(--type-h3); text-transform:uppercase; margin:0 }
  nav h2 { margin-bottom:16px }
  nav a { display:block; padding:9px 10px; border-top:1px solid #0003; font:var(--type-ui-copy) }
  nav a[aria-current=true],.variants a[aria-current=true] { background:var(--color-ink); color:var(--color-paper) }
  nav a:hover,.open:hover { text-decoration:underline }
  .viewer p,.foundations p { font:var(--type-body); max-width:70ch }
  .variants { display:flex; flex-wrap:wrap; gap:6px }
  .variants a { border:1px solid; padding:7px 13px; font:var(--type-ui-copy) }
  pre { white-space:pre-wrap; overflow-wrap:anywhere; padding:16px; background:var(--color-card); margin:16px 0 8px }
  code,.open { font:var(--type-meta) }
  .open { display:inline-block; padding-block:8px; text-decoration:underline }
  iframe { display:block; width:100%; height:78vh; min-height:430px; border:1px solid #0003; margin-top:12px; box-sizing:border-box }
  @media(max-width:760px) {
    .workspace { grid-template-columns:1fr }
    nav { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:12px }
    nav h2 { grid-column:1/-1 }
    .intro h1 { font-size:clamp(54px,13vw,100px) }
    .viewer { scroll-margin-top:16px }
  }
</style>
